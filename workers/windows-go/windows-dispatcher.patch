+// TakeProbeReply transfers one genuine matched DNS datagram, never a success flag.
+func (r *RedundantTunnel) TakeProbeReply(token ProbeToken) []byte {
+	r.probeMu.Lock()
+	defer r.probeMu.Unlock()
+	state, exists := r.probes[token]
+	if !exists || len(state.replies) == 0 {
+		return nil
+	}
+	reply := state.replies[0]
+	state.replies[0] = nil
+	state.replies = state.replies[1:]
+	r.probes[token] = state
+	return reply
+}
