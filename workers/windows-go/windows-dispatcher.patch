+// Per-generation IP packet facts. No encrypted handshake/keepalive bytes and
+// no progress from rejected, inactive or failed real-TUN writes.
+type RedundantSlotStats struct {
+	Generation    uint64 `json:"generation"`
+	Closed        bool   `json:"closed"`
+	TxPackets     uint64 `json:"tx_packets"`
+	RxDataPackets uint64 `json:"rx_data_packets"`
+}
+
+func (r *RedundantTunnel) SlotStats() [2]RedundantSlotStats {
+	r.routeMu.RLock()
+	defer r.routeMu.RUnlock()
+	var stats [2]RedundantSlotStats
+	for index, slot := range r.slots {
+		stats[index] = RedundantSlotStats{Generation: slot.generation.Load(), Closed: r.closed.Load() || slot.closed(), TxPackets: slot.txPackets.Load(), RxDataPackets: slot.rxDataPackets.Load()}
+	}
+	return stats
+}
