{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelomai.ru/schemas/client/v1/connection-start-response.schema.json",
  "type": "object",
  "required": ["api_version", "request_id", "connection", "configuration", "reused"],
  "properties": {
    "api_version": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "connection": { "$ref": "common.schema.json#/$defs/connection" },
    "configuration": { "type": "string", "minLength": 1 },
    "health_probe": { "$ref": "common.schema.json#/$defs/healthProbe" },
    "reused": { "type": "boolean" },
    "redundancy": {
      "type": "object",
      "required": [
        "session_id",
        "state",
        "role_generation",
        "membership_generation",
        "virtual_address_v4",
        "standby_desired"
      ],
      "properties": {
        "session_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "state": { "enum": ["warming", "ready", "degraded", "disabled"] },
        "role_generation": { "$ref": "common.schema.json#/$defs/generation" },
        "membership_generation": { "$ref": "common.schema.json#/$defs/generation" },
        "virtual_address_v4": { "type": "string", "minLength": 1, "maxLength": 64 },
        "standby_desired": { "type": "boolean" },
        "reason": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 120 },
            { "type": "null" }
          ]
        },
        "standby": {
          "anyOf": [
            {
              "type": "object",
              "required": ["health", "connection", "configuration", "health_probe"],
              "properties": {
                "health": {
                  "enum": ["warming", "ready", "suspect", "unhealthy", "recovering"]
                },
                "connection": { "$ref": "common.schema.json#/$defs/connection" },
                "configuration": { "type": "string", "minLength": 1 },
                "health_probe": { "$ref": "common.schema.json#/$defs/healthProbe" }
              },
              "additionalProperties": true
            },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["redundancy"],
        "properties": {
          "redundancy": {
            "properties": {
              "state": { "enum": ["warming", "ready", "degraded"] }
            }
          }
        }
      },
      "then": { "required": ["health_probe"] }
    }
  ],
  "additionalProperties": true
}
