{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelomai.ru/schemas/client/v1/update-manifest.schema.json",
  "type": "object",
  "required": ["api_version", "request_id", "channel", "version", "minimum_version", "critical", "published_at", "notes", "artifacts"],
  "properties": {
    "api_version": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "channel": { "const": "stable" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "minimum_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "critical": { "type": "boolean" },
    "published_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "notes": { "type": "string", "maxLength": 10000 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "platform", "arch", "size_bytes", "sha256", "signature", "download_url"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "platform": { "$ref": "common.schema.json#/$defs/platform" },
          "arch": { "enum": ["x86_64", "aarch64"] },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "signature": { "type": "string", "minLength": 32, "maxLength": 512 },
          "download_url": { "type": "string", "pattern": "^/api/client/v1/updates/[A-Za-z0-9._-]+/download$" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

