{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelomai.ru/schemas/client/v1/bootstrap.schema.json",
  "type": "object",
  "required": [
    "api_version",
    "request_id",
    "access",
    "device",
    "binding",
    "connection",
    "pinned_stray",
    "defaults",
    "update",
    "capabilities"
  ],
  "properties": {
    "api_version": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "access": {
      "type": "object",
      "required": ["state", "can_login", "can_connect", "expires_at"],
      "properties": {
        "state": { "enum": ["active", "expired"] },
        "can_login": { "type": "boolean" },
        "can_connect": { "type": "boolean" },
        "expires_at": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": true
    },
    "device": {
      "type": "object",
      "required": ["id", "name", "platform"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "platform": { "$ref": "common.schema.json#/$defs/platform" }
      },
      "additionalProperties": true
    },
    "binding": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/peerBinding" },
        { "type": "null" }
      ]
    },
    "connection": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/connection" },
        { "type": "null" }
      ]
    },
    "pinned_stray": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/connection" },
        { "type": "null" }
      ]
    },
    "defaults": {
      "type": "object",
      "required": ["layer", "tic_connection_mode", "route_mode"],
      "properties": {
        "layer": { "$ref": "common.schema.json#/$defs/layer" },
        "tic_connection_mode": { "$ref": "common.schema.json#/$defs/ticConnectionMode" },
        "route_mode": { "$ref": "common.schema.json#/$defs/routeMode" }
      },
      "additionalProperties": true
    },
    "update": {
      "type": "object",
      "required": [
        "current_version",
        "minimum_version",
        "update_available",
        "required",
        "release_notes"
      ],
      "properties": {
        "current_version": { "type": ["string", "null"], "maxLength": 64 },
        "minimum_version": { "type": ["string", "null"], "maxLength": 64 },
        "update_available": { "type": "boolean" },
        "required": { "type": "boolean" },
        "release_notes": { "type": ["string", "null"], "maxLength": 10000 }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "required": ["revision", "expires_at", "connection_intent_recovery_v1"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "connection_intent_recovery_v1": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
