{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelomai.ru/schemas/client/v1/bootstrap.schema.json",
  "type": "object",
  "required": ["api_version", "request_id", "access", "device", "defaults", "update", "capabilities"],
  "properties": {
    "api_version": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "access": {
      "type": "object",
      "required": ["state", "can_login", "can_connect", "expires_at"],
      "properties": {
        "state": { "enum": ["active", "expired"] },
        "can_login": { "type": "boolean" },
        "can_connect": { "type": "boolean" },
        "expires_at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "device": {
      "type": "object",
      "required": ["id", "binding_peer_id"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "binding_peer_id": { "anyOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "defaults": {
      "type": "object",
      "required": ["layer", "mode", "route_mode", "probe_refresh_seconds"],
      "properties": {
        "layer": { "$ref": "common.schema.json#/$defs/layer" },
        "mode": { "$ref": "common.schema.json#/$defs/mode" },
        "route_mode": { "$ref": "common.schema.json#/$defs/routeMode" },
        "probe_refresh_seconds": { "type": "integer", "minimum": 60, "maximum": 3600 }
      },
      "additionalProperties": true
    },
    "update": {
      "type": "object",
      "required": ["requirement", "latest_version", "minimum_version"],
      "properties": {
        "requirement": { "enum": ["none", "available", "required"] },
        "latest_version": { "type": "string", "minLength": 1 },
        "minimum_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "required": ["pin_stray", "split_tunnel"],
      "properties": {
        "pin_stray": { "type": "boolean" },
        "split_tunnel": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

