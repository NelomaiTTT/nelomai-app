{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelomai.ru/schemas/client/v1/error.schema.json",
  "type": "object",
  "required": ["request_id", "code", "message"],
  "properties": {
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "code": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 80 },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "additionalProperties": false
}

