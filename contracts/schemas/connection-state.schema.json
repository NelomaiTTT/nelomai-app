{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nelomai.ru/schemas/client/v1/connection-state.schema.json",
  "type": "object",
  "required": ["api_version", "request_id", "status", "operation_id", "layer", "mode", "route_mode", "changed_at", "can_retry", "error"],
  "properties": {
    "api_version": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "status": { "enum": ["disconnected", "probing", "starting", "connected", "stopping", "error"] },
    "operation_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "layer": { "anyOf": [{ "$ref": "common.schema.json#/$defs/layer" }, { "type": "null" }] },
    "mode": { "anyOf": [{ "$ref": "common.schema.json#/$defs/mode" }, { "type": "null" }] },
    "route_mode": { "anyOf": [{ "$ref": "common.schema.json#/$defs/routeMode" }, { "type": "null" }] },
    "changed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "can_retry": { "type": "boolean" },
    "error": { "anyOf": [{ "$ref": "common.schema.json#/$defs/safeError" }, { "type": "null" }] }
  },
  "additionalProperties": true
}

