+func (peer *Peer) cancelHandshakeProbe(generation uint64) {
+	if peer.controlProbe.generation.CompareAndSwap(generation, 0) {
+		peer.controlProbe.retryGeneration.CompareAndSwap(generation, 0)
+		peer.controlProbe.expectedIndex.Store(0)
+	}
+}
+
+func (peer *Peer) completeHandshakeProbe(receiver uint32) {
+	if peer.controlProbe.expectedIndex.Load() != receiver {
+		return
+	}
+	generation := peer.controlProbe.generation.Load()
+	if generation == 0 || !peer.controlProbe.generation.CompareAndSwap(generation, 0) {
+		return
+	}
+	peer.controlProbe.retryGeneration.CompareAndSwap(generation, 0)
+	peer.controlProbe.expectedIndex.Store(0)
+	for {
+		completed := peer.device.controlProbe.completedGeneration.Load()
+		if completed >= generation ||
+			peer.device.controlProbe.completedGeneration.CompareAndSwap(completed, generation) {
+			return
+		}
+	}
+}
