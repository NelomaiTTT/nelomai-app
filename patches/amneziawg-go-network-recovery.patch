+/* SPDX-License-Identifier: MIT */
+
+package device
+
+// LatestHandshakeUnixMillis returns only the newest authenticated peer handshake time.
+// It deliberately avoids the UAPI serialization path, which also contains key material.
+func (device *Device) LatestHandshakeUnixMillis() int64 {
+	device.peers.RLock()
+	defer device.peers.RUnlock()
+	var latest int64
+	for _, peer := range device.peers.keyMap {
+		if current := peer.lastHandshakeNano.Load(); current > latest {
+			latest = current
+		}
+	}
+	return latest / 1_000_000
+}
