@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: MIT */
+
+package device
+
+import (
+	"fmt"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/conn/bindtest"
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun/tuntest"
+)
+
+func TestMalformedUAPIConfigDoesNotLogSourceLine(t *testing.T) {
+	const secretLine = "private_key super-secret-material"
+	var logs struct {
+		sync.Mutex
+		strings.Builder
+	}
+	logger := &Logger{
+		Verbosef: DiscardLogf,
+		Errorf: func(format string, args ...any) {
+			logs.Lock()
+			defer logs.Unlock()
+			_, _ = fmt.Fprintf(&logs.Builder, format, args...)
+		},
+	}
+	binds := bindtest.NewChannelBinds()
+	channelTUN := tuntest.NewChannelTUN()
+	device := NewDevice(channelTUN.TUN(), binds[0], logger)
+	t.Cleanup(device.Close)
+
+	if err := device.IpcSet(secretLine + "\n"); err == nil {
+		t.Fatal("malformed UAPI configuration was accepted")
+	}
+	logs.Lock()
+	logged := logs.String()
+	logs.Unlock()
+	if strings.Contains(logged, secretLine) || strings.Contains(logged, "super-secret-material") {
+		t.Fatalf("malformed UAPI source line leaked into logs: %q", logged)
+	}
+}
