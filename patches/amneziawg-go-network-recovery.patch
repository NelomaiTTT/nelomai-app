+	}
+	device := pair[0].dev
+	peer := device.runningPeersSnapshot()[0]
+	generation := device.StartHandshakeProbe()
+	if generation == 0 {
+		t.Fatal("handshake probe was not started")
+	}
+	firstIndex := peer.controlProbe.expectedIndex.Load()
+	peer.handshake.mutex.Lock()
+	peer.handshake.lastSentHandshake = time.Now().Add(
+		-(peer.device.rekeyMinTimeout() + time.Second),
+	)
+	peer.handshake.mutex.Unlock()
+	if err := peer.SendHandshakeInitiation(true); err != nil {
+		t.Fatalf("failed to send handshake probe retry: %v", err)
+	}
+	retryIndex := peer.controlProbe.expectedIndex.Load()
+	if firstIndex == 0 || retryIndex == 0 || retryIndex == firstIndex {
+		t.Fatalf("retry index is %d after initial index %d", retryIndex, firstIndex)
+	}
+	if got := peer.controlProbe.retryGeneration.Load(); got != generation {
+		t.Fatalf("retry generation is %d, want %d", got, generation)
+	}
+}
