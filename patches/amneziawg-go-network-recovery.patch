@@ -0,0 +1,34 @@
+//go:build linux
+
+package tun
+
+import (
+	"errors"
+	"runtime/debug"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestCreateUnmonitoredTUNFromFDConsumesDescriptorOnFailure(t *testing.T) {
+	previousGCPercent := debug.SetGCPercent(-1)
+	defer debug.SetGCPercent(previousGCPercent)
+
+	pipe := make([]int, 2)
+	if err := unix.Pipe(pipe); err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(pipe[1])
+
+	device, _, err := CreateUnmonitoredTUNFromFD(pipe[0])
+	if err == nil {
+		device.Close()
+		t.Fatal("expected a non-TUN descriptor to be rejected")
+	}
+	if _, err := unix.FcntlInt(uintptr(pipe[0]), unix.F_GETFD, 0); !errors.Is(err, unix.EBADF) {
+		if err == nil {
+			unix.Close(pipe[0])
+		}
+		t.Fatalf("descriptor remains owned by the caller after failure: %v", err)
+	}
+}
