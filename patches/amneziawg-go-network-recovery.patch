+// SendKeepalivesToAllRunningPeers queues one keepalive for every running peer
+// without changing its configured persistent keepalive interval.
+func (device *Device) SendKeepalivesToAllRunningPeers() int {
+	peers := device.runningPeersSnapshot()
+	for _, peer := range peers {
+		peer.SendKeepalive()
+	}
+	return len(peers)
+}
+
+// StartHandshakeProbe forces a fresh authenticated handshake without expiring
+// the current data-plane keypair. The returned generation is completed only by
+// a response to this initiation or one of its native retries.
+func (device *Device) StartHandshakeProbe() uint64 {
+	peers := device.runningPeersSnapshot()
+	if len(peers) == 0 {
+		return 0
+	}
+	generation := device.controlProbe.nextGeneration.Add(1)
+	if generation == 0 {
+		generation = device.controlProbe.nextGeneration.Add(1)
+	}
+	sent := 0
+	for _, peer := range peers {
+		peer.controlProbe.expectedIndex.Store(0)
+		peer.controlProbe.generation.Store(generation)
+		peer.handshake.mutex.Lock()
+		peer.handshake.lastSentHandshake = time.Now().Add(
+			-(peer.device.rekeyMinTimeout() + time.Second),
+		)
+		peer.handshake.mutex.Unlock()
+		if peer.SendHandshakeProbe(generation) == nil {
+			sent++
+		} else {
+			peer.cancelHandshakeProbe(generation)
+		}
+	}
+	if sent == 0 {
+		return 0
+	}
+	return generation
+}
+
+// HandshakeProbeSucceeded reports only authenticated responses belonging to
+// the requested probe generation.
+func (device *Device) HandshakeProbeSucceeded(generation uint64) bool {
+	return generation != 0 && device.controlProbe.completedGeneration.Load() >= generation
+}
+
+// HandshakeProbeTimeoutMillis includes the longest configured first retry and
+// enough time for its response to be authenticated by the native backend.
+func (device *Device) HandshakeProbeTimeoutMillis() int64 {
+	timeout := RekeyTimeout
+	if configured := device.timings.rekeyTimeoutSec.Load(); !configured.IsZero() {
+		timeout = time.Duration(configured.Hi()) * time.Second
+	}
+	return (timeout +
+		time.Duration(RekeyTimeoutJitterMaxMs)*time.Millisecond +
+		time.Second).Milliseconds()
+}
+
+func (device *Device) runningPeersSnapshot() []*Peer {
+	device.peers.RLock()
+	peers := make([]*Peer, 0, len(device.peers.keyMap))
+	for _, peer := range device.peers.keyMap {
+		if peer.isRunning.Load() {
+			peers = append(peers, peer)
+		}
+	}
+	device.peers.RUnlock()
+	return peers
+}
