+
+func TestCloseSlotWaitsForInboundDispatcherRouteBarrier(t *testing.T) {
+	_, slotA, _, tunnel := newFakeRedundantTunnel(t)
+	tunnel.routeMu.Lock()
+	writeDevicePacket(t, slotA, []byte{7, 7, 7})
+
+	closed := make(chan error, 1)
+	go func() {
+		closed <- tunnel.CloseSlot(0)
+	}()
+	select {
+	case err := <-closed:
+		tunnel.routeMu.Unlock()
+		t.Fatalf("slot close returned before inbound dispatcher quiesced: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	tunnel.routeMu.Unlock()
+	select {
+	case err := <-closed:
+		if err != nil {
+			t.Fatalf("failed to close active slot: %v", err)
+		}
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("slot close did not finish after dispatcher was released")
+	}
+}
