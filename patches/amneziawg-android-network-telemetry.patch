+
+func (d *diagnosticTun) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	n, err := d.Device.Read(bufs, sizes, offset)
+	var bytes uint64
+	for i := 0; i < n && i < len(sizes); i++ {
+		if sizes[i] > 0 {
+			bytes += uint64(sizes[i])
+		}
+	}
+	d.telemetry.tunReadPackets.Add(uint64(max(n, 0)))
