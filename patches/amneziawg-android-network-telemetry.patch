+func TestCancelWaitsForConcurrentProbeInjection(t *testing.T) {
+	_, _, slotB, tunnel := newFakeRedundantTunnel(t)
+	token := ProbeToken{Port: 5353, DNSID: 14}
+	query := fakeDNSPacket(token.Port, 53, token.DNSID, false)
+	tunnel.routeMu.Lock()
+	injected := make(chan error, 1)
+	go func() {
+		injected <- tunnel.InjectProbe(1, query, token)
+	}()
+	deadline := time.Now().Add(redundantTUNTestTimeout)
+	for {
+		tunnel.probeMu.Lock()
+		_, registered := tunnel.probes[token]
+		tunnel.probeMu.Unlock()
+		if registered {
+			break
+		}
+		if time.Now().After(deadline) {
+			tunnel.routeMu.Unlock()
+			t.Fatal("probe was not registered before enqueue")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	cancelled := make(chan struct{})
+	go func() {
+		tunnel.CancelProbe(token)
+		close(cancelled)
+	}()
+	select {
+	case <-cancelled:
+		tunnel.routeMu.Unlock()
+		t.Fatal("probe cancellation returned before concurrent injection completed")
+	case <-time.After(20 * time.Millisecond):
+	}
+	tunnel.routeMu.Unlock()
+	if err := <-injected; err != nil {
+		t.Fatalf("concurrent probe injection failed: %v", err)
+	}
+	select {
+	case <-cancelled:
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("probe cancellation did not finish after injection")
+	}
+	requireNoDevicePacketBeforeClose(t, slotB, func() error {
+		return tunnel.CloseSlot(1)
+	})
+}
