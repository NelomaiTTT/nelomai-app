+}
+
+func nowUnixMillis() int64 {
+	return time.Now().UnixMilli()
+}
+
+func diagnosticError(err error) string {
+	if err == nil {
+		return ""
+	}
+	value := err.Error()
+	if len(value) > 160 {
+		return value[:160]
+	}
+	return value
+}
+
+func diagnosticErrno(err error) int {
+	var errno syscall.Errno
+	if errors.As(err, &errno) {
+		return int(errno)
+	}
+	return 0
+}
+
+func atomicString(value *atomic.Value) string {
+	stored := value.Load()
+	if stored == nil {
+		return ""
+	}
+	return stored.(string)
+}
+
+func (t *tunnelTelemetry) shouldCaptureEndpoint(now int64) bool {
+	if now <= 0 {
+		return false
+	}
+	for {
+		previous := t.endpointAt.Load()
+		if previous > 0 && now >= previous && now-previous < 1_000 {
+			return false
+		}
+		if t.endpointAt.CompareAndSwap(previous, now) {
+			return true
+		}
+	}
+}
+
+func (t *tunnelTelemetry) snapshot() tunnelTelemetrySnapshot {
+	return tunnelTelemetrySnapshot{
+		TunReadPackets: t.tunReadPackets.Load(), TunReadBytes: t.tunReadBytes.Load(),
+		TunReadErrors: t.tunReadErrors.Load(), TunWritePackets: t.tunWritePackets.Load(),
+		TunWriteBytes: t.tunWriteBytes.Load(), TunWriteErrors: t.tunWriteErrors.Load(),
+		UdpSendCalls: t.udpSendCalls.Load(), UdpSendPackets: t.udpSendPackets.Load(),
