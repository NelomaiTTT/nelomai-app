+func TestAdmissionBindRejectsStalePreparationToken(t *testing.T) {
+	initial := &fakeAdmissionBind{fds: [2]int{101, 102}}
+	rebound := &fakeAdmissionBind{fds: [2]int{201, 202}}
+	binds := []conn.Bind{initial, rebound}
+	bind := newAdmissionBind(func() conn.Bind {
+		result := binds[0]
+		binds = binds[1:]
+		return result
+	})
+	if _, _, err := bind.Open(0); err != nil {
+		t.Fatalf("prepare initial bind: %v", err)
+	}
+	first, err := bind.PreparedSockets()
+	if err != nil {
+		t.Fatalf("discover initial preparation: %v", err)
+	}
+	if err := bind.AdmitPreparedToken(first.Token); err != nil {
+		t.Fatalf("admit initial preparation: %v", err)
+	}
+	if err := bind.PrepareRebind(0); err != nil {
+		t.Fatalf("prepare rebound bind: %v", err)
+	}
+	second, err := bind.PreparedSockets()
+	if err != nil {
+		t.Fatalf("discover rebound preparation: %v", err)
+	}
+
+	if err := bind.AbortPreparedToken(first.Token); !errors.Is(err, errAdmissionBindGeneration) {
+		t.Fatalf("stale abort returned %v, want %v", err, errAdmissionBindGeneration)
+	}
+	if err := bind.AdmitPreparedToken(first.Token); !errors.Is(err, errAdmissionBindGeneration) {
+		t.Fatalf("stale admit returned %v, want %v", err, errAdmissionBindGeneration)
+	}
+	if err := bind.AdmitPreparedToken(second.Token); err != nil {
+		t.Fatalf("current preparation was not preserved: %v", err)
+	}
+}
