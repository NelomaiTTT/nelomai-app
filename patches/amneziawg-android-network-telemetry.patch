+JNIEXPORT jlong JNICALL Java_ru_nelomai_tunnel_JniRedundantNativeApi_nativeStartProbe(
+	JNIEnv *env,
+	jobject self,
+	jlong handle,
+	jint slot,
+	jstring source_ipv4,
+	jstring target_ipv4,
+	jstring query_name)
+{
+	if (source_ipv4 == NULL || target_ipv4 == NULL || query_name == NULL)
+		return -1;
+	const char *source = (*env)->GetStringUTFChars(env, source_ipv4, NULL);
+	if (source == NULL)
+		return -1;
+	const char *target = (*env)->GetStringUTFChars(env, target_ipv4, NULL);
+	if (target == NULL) {
+		(*env)->ReleaseStringUTFChars(env, source_ipv4, source);
+		return -1;
+	}
+	const char *query = (*env)->GetStringUTFChars(env, query_name, NULL);
+	if (query == NULL) {
+		(*env)->ReleaseStringUTFChars(env, target_ipv4, target);
+		(*env)->ReleaseStringUTFChars(env, source_ipv4, source);
+		return -1;
+	}
+	long long token = awgRedundantStartProbe(
+		(long long)handle,
+		slot,
+		(struct go_string){.str = source, .n = (*env)->GetStringUTFLength(env, source_ipv4)},
+		(struct go_string){.str = target, .n = (*env)->GetStringUTFLength(env, target_ipv4)},
+		(struct go_string){.str = query, .n = (*env)->GetStringUTFLength(env, query_name)}
+	);
+	(*env)->ReleaseStringUTFChars(env, query_name, query);
+	(*env)->ReleaseStringUTFChars(env, target_ipv4, target);
+	(*env)->ReleaseStringUTFChars(env, source_ipv4, source);
