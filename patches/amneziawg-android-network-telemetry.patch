@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestRedundantMetricsExcludeEndpointAndArbitraryErrorText(t *testing.T) {
+	snapshot := tunnelTelemetrySnapshot{
+		LastSendError: "private_key=send-secret",
+		LastRecvError: "private_key=receive-secret",
+		Endpoint:      "sensitive.example:51820",
+		LastSendErrno: 101,
+		LastRecvErrno: 113,
+	}
+	encoded, err := json.Marshal(redactRedundantTelemetry(snapshot))
+	if err != nil {
+		t.Fatalf("encode redundant telemetry: %v", err)
+	}
+	for _, forbidden := range []string{
+		"private_key",
+		"send-secret",
+		"receive-secret",
+		"sensitive.example",
+		"endpoint",
+		"last_udp_send_error",
+		"last_udp_receive_error",
+	} {
+		if strings.Contains(string(encoded), forbidden) {
+			t.Fatalf("redundant metrics exposed %q in %s", forbidden, encoded)
+		}
+	}
+	if !strings.Contains(string(encoded), `"last_udp_send_errno":101`) ||
+		!strings.Contains(string(encoded), `"last_udp_receive_errno":113`) {
+		t.Fatalf("redundant metrics lost bounded errno diagnostics: %s", encoded)
+	}
+}
diff --git a/tunnel/tools/libwg-go/redundant_probe.go b/tunnel/tools/libwg-go/redundant_probe.go
new file mode 100644
index 00000000..29aebbbe
--- /dev/null
+++ b/tunnel/tools/libwg-go/redundant_probe.go
@@ -0,0 +1,286 @@
+package main
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	redundantProbePending int32 = iota
+	redundantProbeSucceeded
+	redundantProbeFailed
+	redundantProbeUnknown
+)
+
+type redundantNativeProbe struct {
+	slot      uint32
+	token     ProbeToken
+	startedAt time.Time
+}
+
+type redundantProbeRegistry struct {
+	mu        sync.Mutex
+	tunnel    *RedundantTunnel
+	random    io.Reader
+	now       func() time.Time
+	allocator monotonicHandleAllocator
+	probes    map[int64]redundantNativeProbe
+}
+
+func newRedundantProbeRegistry(tunnel *RedundantTunnel) *redundantProbeRegistry {
+	return &redundantProbeRegistry{
+		tunnel: tunnel,
+		random: rand.Reader,
+		now:    time.Now,
+		probes: make(map[int64]redundantNativeProbe),
+	}
+}
+
+func (r *redundantProbeRegistry) Start(slot int32, source, target, queryName string) int64 {
+	if r == nil || r.tunnel == nil || slot < 0 || slot >= redundantTunnelSlotCount {
+		return -1
+	}
+	sourceIP, ok := canonicalProbeSourceIPv4(source)
+	if !ok {
+		return -1
+	}
+	targetIP, ok := canonicalProbeTargetIPv4(target)
+	if !ok || !canonicalProbeQueryName(queryName) {
+		return -1
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for attempt := 0; attempt < 16; attempt++ {
+		token, ok := r.nextTupleLocked()
+		if !ok {
+			return -1
+		}
+		packet := buildIPv4DNSProbe(sourceIP, targetIP, queryName, token)
+		if packet == nil {
+			return -1
+		}
+		if err := r.tunnel.InjectProbe(uint32(slot), packet, token); err != nil {
+			if errors.Is(err, ErrProbeAlreadyPending) {
+				continue
+			}
+			return -1
+		}
+		opaque := r.allocator.Next()
+		if opaque <= 0 {
+			r.tunnel.CancelProbe(token)
+			return -1
+		}
+		if _, exists := r.probes[opaque]; exists {
+			r.tunnel.CancelProbe(token)
+			return -1
+		}
+		r.probes[opaque] = redundantNativeProbe{
+			slot: uint32(slot), token: token, startedAt: r.now(),
+		}
+		return opaque
+	}
+	return -1
+}
+
+func (r *redundantProbeRegistry) Status(opaque int64) int32 {
+	if r == nil || opaque <= 0 {
+		return redundantProbeUnknown
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	probe, ok := r.probes[opaque]
+	if !ok {
+		return redundantProbeUnknown
+	}
+	if !r.tunnel.ProbeSucceeded(probe.token) {
+		if now := r.now(); !now.Before(probe.startedAt.Add(redundantTunnelProbeRetention)) {
+			delete(r.probes, opaque)
+			r.tunnel.CancelProbe(probe.token)
+			return redundantProbeFailed
+		}
+		return redundantProbePending
+	}
+	delete(r.probes, opaque)
+	return redundantProbeSucceeded
+}
+
+func (r *redundantProbeRegistry) Cancel(opaque int64) bool {
+	if r == nil || opaque <= 0 {
+		return false
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	probe, ok := r.probes[opaque]
+	if !ok {
+		return false
+	}
+	delete(r.probes, opaque)
+	r.tunnel.CancelProbe(probe.token)
+	return true
+}
+
+func (r *redundantProbeRegistry) CancelSlot(slot uint32) {
+	if r == nil {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for opaque, probe := range r.probes {
+		if probe.slot == slot {
+			delete(r.probes, opaque)
+			r.tunnel.CancelProbe(probe.token)
+		}
+	}
+}
+
+func (r *redundantProbeRegistry) CancelAll() {
+	if r == nil {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	for opaque, probe := range r.probes {
+		delete(r.probes, opaque)
+		r.tunnel.CancelProbe(probe.token)
+	}
+}
+
+func (r *redundantProbeRegistry) nextTupleLocked() (ProbeToken, bool) {
+	var bytes [4]byte
+	for attempt := 0; attempt < 16; attempt++ {
+		if _, err := io.ReadFull(r.random, bytes[:]); err != nil {
+			return ProbeToken{}, false
+		}
+		token := ProbeToken{
+			Port:  49152 + binary.BigEndian.Uint16(bytes[:2])%16384,
+			DNSID: binary.BigEndian.Uint16(bytes[2:]),
+		}
+		if token.DNSID == 0 {
+			token.DNSID = 1
+		}
+		collision := false
+		for _, probe := range r.probes {
+			if probe.token == token {
+				collision = true
+				break
+			}
+		}
+		if !collision {
+			return token, true
+		}
+	}
+	return ProbeToken{}, false
+}
+
+func canonicalProbeSourceIPv4(value string) ([4]byte, bool) {
+	var result [4]byte
+	ip, network, err := net.ParseCIDR(value)
+	if err != nil {
+		return result, false
+	}
+	ones, bits := network.Mask.Size()
+	parsed := ip.To4()
+	if parsed == nil || bits != 32 || ones != 32 || value != ip.String()+"/32" {
+		return result, false
+	}
+	copy(result[:], parsed)
+	return result, true
+}
+
+func canonicalProbeTargetIPv4(value string) ([4]byte, bool) {
+	var result [4]byte
+	parsed := net.ParseIP(value).To4()
+	if parsed == nil || strings.Contains(value, "/") || value != net.IP(parsed).String() {
+		return result, false
+	}
+	copy(result[:], parsed)
+	return result, true
+}
+
+func canonicalProbeQueryName(value string) bool {
+	if len(value) == 0 || len(value) > 253 || value != strings.ToLower(value) || strings.HasSuffix(value, ".") {
+		return false
+	}
+	for _, label := range strings.Split(value, ".") {
+		if len(label) == 0 || len(label) > 63 || label[0] == '-' || label[len(label)-1] == '-' {
+			return false
+		}
+		for index := range label {
+			character := label[index]
+			if !((character >= 'a' && character <= 'z') ||
+				(character >= '0' && character <= '9') || character == '-') {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func buildIPv4DNSProbe(source, target [4]byte, queryName string, token ProbeToken) []byte {
+	dnsLength := 12 + len(queryName) + 2 + 4
+	packet := make([]byte, 20+8+dnsLength)
+	packet[0] = 0x45
+	packet[1] = 0
+	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
+	packet[6] = 0x40
+	packet[8] = 64
+	packet[9] = 17
+	copy(packet[12:16], source[:])
+	copy(packet[16:20], target[:])
+	binary.BigEndian.PutUint16(packet[20:22], token.Port)
+	binary.BigEndian.PutUint16(packet[22:24], 53)
+	binary.BigEndian.PutUint16(packet[24:26], uint16(8+dnsLength))
+	dns := packet[28:]
+	binary.BigEndian.PutUint16(dns[:2], token.DNSID)
+	binary.BigEndian.PutUint16(dns[2:4], 0x0100)
+	binary.BigEndian.PutUint16(dns[4:6], 1)
+	offset := 12
+	for _, label := range strings.Split(queryName, ".") {
+		dns[offset] = byte(len(label))
+		offset++
+		copy(dns[offset:], label)
+		offset += len(label)
+	}
+	dns[offset] = 0
+	offset++
+	binary.BigEndian.PutUint16(dns[offset:offset+2], 1)
+	binary.BigEndian.PutUint16(dns[offset+2:offset+4], 1)
+	binary.BigEndian.PutUint16(packet[10:12], internetChecksum(packet[:20]))
+	udpChecksum := udpIPv4Checksum(source, target, packet[20:])
+	if udpChecksum == 0 {
+		udpChecksum = 0xffff
+	}
+	binary.BigEndian.PutUint16(packet[26:28], udpChecksum)
+	return packet
+}
+
+func internetChecksum(data []byte) uint16 {
+	var sum uint32
+	for len(data) >= 2 {
+		sum += uint32(binary.BigEndian.Uint16(data[:2]))
+		data = data[2:]
+	}
+	if len(data) == 1 {
+		sum += uint32(data[0]) << 8
+	}
+	for sum>>16 != 0 {
+		sum = sum&0xffff + sum>>16
+	}
+	return ^uint16(sum)
+}
+
+func udpIPv4Checksum(source, target [4]byte, udp []byte) uint16 {
+	pseudo := make([]byte, 12+len(udp))
+	copy(pseudo[:4], source[:])
+	copy(pseudo[4:8], target[:])
+	pseudo[9] = 17
+	binary.BigEndian.PutUint16(pseudo[10:12], uint16(len(udp)))
+	copy(pseudo[12:], udp)
+	return internetChecksum(pseudo)
+}
