+func TestProbeReplyMustMatchQuestionAndIPEndpoints(t *testing.T) {
+	real, slotA, _, tunnel := newFakeRedundantTunnel(t)
+	token := ProbeToken{Port: 5353, DNSID: 11}
+	query := fakeDNSPacket(token.Port, 53, token.DNSID, false)
+	wrongQuestion := fakeDNSPacketForQuestion(
+		53,
+		token.Port,
+		token.DNSID,
+		true,
+		[4]byte{1, 1, 1, 1},
+		[4]byte{10, 0, 0, 2},
+		"unrelated.nelomai.invalid",
+	)
+
+	if err := tunnel.InjectProbe(0, query, token); err != nil {
+		t.Fatalf("failed to inject probe: %v", err)
+	}
+	_ = readDevicePacket(t, slotA)
+	writeDevicePacket(t, slotA, wrongQuestion)
+	select {
+	case got := <-real.inbound:
+		if string(got) != string(wrongQuestion) {
+			t.Fatalf("real TUN received %v, want %v", got, wrongQuestion)
+		}
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("unrelated DNS packet was incorrectly consumed")
+	}
+	if tunnel.ProbeSucceeded(token) {
+		t.Fatal("unrelated DNS question satisfied the probe")
+	}
+	wrongEndpoint := fakeDNSPacketForQuestion(
+		53,
+		token.Port,
+		token.DNSID,
+		true,
+		[4]byte{9, 9, 9, 9},
+		[4]byte{10, 0, 0, 2},
+		"health.nelomai.invalid",
+	)
+	writeDevicePacket(t, slotA, wrongEndpoint)
+	select {
+	case got := <-real.inbound:
+		if string(got) != string(wrongEndpoint) {
+			t.Fatalf("real TUN received %v, want %v", got, wrongEndpoint)
+		}
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("DNS packet from an unrelated endpoint was incorrectly consumed")
+	}
+	if tunnel.ProbeSucceeded(token) {
+		t.Fatal("unrelated DNS endpoint satisfied the probe")
+	}
