+func TestChannelTUNFullQueueRejectsWriteWithoutAllocation(t *testing.T) {
+	device := newChannelTUN(nil, 0, 1420, "bounded-write", 1, 1)
+	if written, err := device.Write([][]byte{{1}}, 0); err != nil || written != 1 {
+		t.Fatalf("failed to fill inbound queue: packets=%d error=%v", written, err)
+	}
+	packet := [][]byte{{2}}
+	var (
+		written int
+		err     error
+	)
+	allocations := testing.AllocsPerRun(100, func() {
+		written, err = device.Write(packet, 0)
+	})
+	if !errors.Is(err, ErrPacketQueueFull) || written != 0 {
+		t.Fatalf("full queue write returned packets=%d error=%v", written, err)
+	}
+	if allocations != 0 {
+		t.Fatalf("full queue rejection allocated %.2f objects per write, want 0", allocations)
+	}
+}
