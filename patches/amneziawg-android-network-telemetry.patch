+func TestAdmissionBindFailedRebindPreservesActiveSocketSet(t *testing.T) {
+	initial := &fakeAdmissionBind{fds: [2]int{101, 102}}
+	rebound := &fakeAdmissionBind{fds: [2]int{201, 202}}
+	binds := []conn.Bind{initial, rebound}
+	bind := newAdmissionBind(func() conn.Bind {
+		result := binds[0]
+		binds = binds[1:]
+		return result
+	})
+	if _, _, err := bind.Open(0); err != nil {
+		t.Fatalf("prepare initial bind: %v", err)
+	}
+	initialPreparation := requirePreparedSockets(t, bind)
+	if err := bind.AdmitPreparedToken(initialPreparation.Token); err != nil {
+		t.Fatalf("admit initial bind: %v", err)
+	}
+	if err := bind.PrepareRebind(70); err != nil {
+		t.Fatalf("prepare rebound bind: %v", err)
+	}
+	reboundPreparation := requirePreparedSockets(t, bind)
+	if got := reboundPreparation.FDs; len(got) != 2 || got[0] != 201 || got[1] != 202 {
+		t.Fatalf("rebound socket descriptors = %v, want [201 202]", got)
+	}
+	if err := bind.AbortPreparedToken(reboundPreparation.Token); err != nil {
+		t.Fatalf("abort rebound preparation: %v", err)
+	}
+	if port, ok := bind.ActivePort(); !ok || port != 1 {
+		t.Fatalf("active port after aborted rebind = %d, %v; want 1, true", port, ok)
+	}
+	if err := bind.Send([][]byte{{1}}, nil); err != nil {
+		t.Fatalf("send through preserved bind: %v", err)
+	}
+	if initial.sendCalls != 1 || initial.closeCalls != 0 {
+		t.Fatalf("active bind changed after abort: sends=%d closes=%d", initial.sendCalls, initial.closeCalls)
+	}
+	if rebound.sendCalls != 0 || rebound.closeCalls != 1 {
+		t.Fatalf("pending bind was not discarded: sends=%d closes=%d", rebound.sendCalls, rebound.closeCalls)
+	}
+}
