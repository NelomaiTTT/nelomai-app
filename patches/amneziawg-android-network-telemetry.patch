+func TestDirectSlotCloseUsesDispatcherRouteBarrier(t *testing.T) {
+	_, _, slotB, tunnel := newFakeRedundantTunnel(t)
+	tunnel.routeMu.Lock()
+	closed := make(chan error, 1)
+	go func() {
+		closed <- slotB.Close()
+	}()
+	select {
+	case err := <-closed:
+		tunnel.routeMu.Unlock()
+		t.Fatalf("direct slot close bypassed route barrier: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	tunnel.routeMu.Unlock()
+	select {
+	case err := <-closed:
+		if err != nil {
+			t.Fatalf("direct slot close failed: %v", err)
+		}
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("direct slot close did not finish after route barrier was released")
+	}
+	if err := tunnel.SwitchActive(1); !errors.Is(err, ErrRedundantSlotClosed) {
+		t.Fatalf("switch after direct close returned %v, want %v", err, ErrRedundantSlotClosed)
+	}
+	if got := tunnel.Counters().SlotCloses; got != 1 {
+		t.Fatalf("direct slot close counter is %d, want 1", got)
+	}
+}
