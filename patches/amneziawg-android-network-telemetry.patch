+/* SPDX-License-Identifier: Apache-2.0 */
+
+package main
+
+import (
+	"encoding/binary"
+	"errors"
+	"os"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+)
+
+const redundantTUNTestTimeout = 250 * time.Millisecond
+
+type fakeRealTUN struct {
+	outbound chan []byte
+	inbound  chan []byte
+	events   chan tun.Event
+	closed   chan struct{}
+	once     sync.Once
+}
+
+func newFakeRealTUN() *fakeRealTUN {
+	device := &fakeRealTUN{
+		outbound: make(chan []byte, 8),
+		inbound:  make(chan []byte, 8),
+		events:   make(chan tun.Event, 1),
+		closed:   make(chan struct{}),
+	}
+	device.events <- tun.EventUp
+	return device
+}
+
+func (f *fakeRealTUN) File() *os.File { return nil }
+
+func (f *fakeRealTUN) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	select {
+	case <-f.closed:
+		return 0, os.ErrClosed
+	case packet := <-f.outbound:
+		if len(bufs) == 0 || len(sizes) == 0 || offset < 0 || offset+len(packet) > len(bufs[0]) {
+			return 0, errors.New("fake TUN read buffer is too small")
+		}
+		copy(bufs[0][offset:], packet)
+		sizes[0] = len(packet)
+		return 1, nil
+	}
+}
+
+func (f *fakeRealTUN) Write(bufs [][]byte, offset int) (int, error) {
+	for index, buffer := range bufs {
+		if offset < 0 || offset > len(buffer) {
+			return index, errors.New("invalid fake TUN write offset")
+		}
+		packet := append([]byte(nil), buffer[offset:]...)
+		select {
+		case <-f.closed:
+			return index, os.ErrClosed
+		case f.inbound <- packet:
+		}
+	}
+	return len(bufs), nil
+}
+
+func (f *fakeRealTUN) MTU() (int, error)        { return 1420, nil }
+func (f *fakeRealTUN) Name() (string, error)    { return "fake-real-tun", nil }
+func (f *fakeRealTUN) Events() <-chan tun.Event { return f.events }
+func (f *fakeRealTUN) BatchSize() int           { return 1 }
+
+func (f *fakeRealTUN) Close() error {
+	f.once.Do(func() {
+		close(f.closed)
+		close(f.events)
+	})
+	return nil
+}
+
+func (f *fakeRealTUN) injectOutbound(t *testing.T, packet []byte) {
+	t.Helper()
+	select {
+	case f.outbound <- append([]byte(nil), packet...):
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("timed out injecting outbound packet into fake real TUN")
+	}
+}
+
+func readDevicePacket(t *testing.T, device tun.Device) []byte {
+	t.Helper()
+	result := make(chan struct {
+		packet []byte
+		err    error
+	}, 1)
+	go func() {
+		buffer := make([]byte, 2048)
+		sizes := make([]int, 1)
+		count, err := device.Read([][]byte{buffer}, sizes, 0)
+		if err != nil {
+			result <- struct {
+				packet []byte
+				err    error
+			}{err: err}
+			return
+		}
+		if count != 1 {
+			result <- struct {
+				packet []byte
+				err    error
+			}{err: errors.New("device returned an unexpected packet count")}
+			return
+		}
+		result <- struct {
+			packet []byte
+			err    error
+		}{packet: append([]byte(nil), buffer[:sizes[0]]...)}
+	}()
+	select {
+	case got := <-result:
+		if got.err != nil {
+			t.Fatalf("failed to read device packet: %v", got.err)
+		}
+		return got.packet
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("timed out reading device packet")
+		return nil
+	}
+}
+
+func writeDevicePacket(t *testing.T, device tun.Device, packet []byte) {
+	t.Helper()
+	written, err := device.Write([][]byte{append([]byte(nil), packet...)}, 0)
+	if err != nil {
+		t.Fatalf("failed to write device packet: %v", err)
+	}
+	if written != 1 {
+		t.Fatalf("device wrote %d packets, want 1", written)
+	}
+}
+
+func requireNoDevicePacketBeforeClose(
+	t *testing.T,
+	device tun.Device,
+	closeDevice func() error,
+) {
+	t.Helper()
+	result := make(chan error, 1)
+	go func() {
+		buffer := make([]byte, 2048)
+		_, err := device.Read([][]byte{buffer}, make([]int, 1), 0)
+		result <- err
+	}()
+	select {
+	case err := <-result:
+		t.Fatalf("inactive device returned before close: %v", err)
+	case <-time.After(50 * time.Millisecond):
+	}
+	if err := closeDevice(); err != nil {
+		t.Fatalf("failed to close inactive device: %v", err)
+	}
+	select {
+	case err := <-result:
+		if !errors.Is(err, os.ErrClosed) {
+			t.Fatalf("inactive device returned wrong close error: %v", err)
+		}
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("inactive device read did not unblock after close")
+	}
+}
+
+func requireNoFakeRealTUNPacket(t *testing.T, real *fakeRealTUN) {
+	t.Helper()
+	select {
+	case packet := <-real.inbound:
+		t.Fatalf("unexpected packet reached real TUN: %v", packet)
+	case <-time.After(50 * time.Millisecond):
+	}
+}
+
+func waitForOutboundAccounting(t *testing.T, tunnel *RedundantTunnel, want uint64) {
+	t.Helper()
+	deadline := time.Now().Add(redundantTUNTestTimeout)
+	for time.Now().Before(deadline) {
+		counters := tunnel.Counters()
+		if counters.OutboundPackets+counters.OutboundDropped >= want {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatalf("dispatcher did not account for %d outbound packets", want)
+}
+
+func fakeDNSPacket(sourcePort, destinationPort, dnsID uint16, response bool) []byte {
+	querySource := [4]byte{10, 0, 0, 2}
+	resolver := [4]byte{1, 1, 1, 1}
+	if response {
+		return fakeDNSPacketForQuestion(
+			sourcePort,
+			destinationPort,
+			dnsID,
+			true,
+			resolver,
+			querySource,
+			"health.nelomai.invalid",
+		)
+	}
+	return fakeDNSPacketForQuestion(
+		sourcePort,
+		destinationPort,
+		dnsID,
+		false,
+		querySource,
+		resolver,
+		"health.nelomai.invalid",
+	)
+}
+
+func fakeDNSPacketForQuestion(
+	sourcePort, destinationPort, dnsID uint16,
+	response bool,
+	sourceIP, destinationIP [4]byte,
+	labels ...string,
+) []byte {
+	const ipv4HeaderLength = 20
+	const udpHeaderLength = 8
+	dnsQuestion := make([]byte, 0, 64)
+	for _, labelSet := range labels {
+		for len(labelSet) > 0 {
+			labelLength := 0
+			for labelLength < len(labelSet) && labelSet[labelLength] != '.' {
+				labelLength++
+			}
+			dnsQuestion = append(dnsQuestion, byte(labelLength))
+			dnsQuestion = append(dnsQuestion, labelSet[:labelLength]...)
+			if labelLength == len(labelSet) {
+				labelSet = ""
+			} else {
+				labelSet = labelSet[labelLength+1:]
+			}
+		}
+	}
+	dnsQuestion = append(dnsQuestion, 0, 0, 1, 0, 1)
+	dnsLength := 12 + len(dnsQuestion)
+	packet := make([]byte, ipv4HeaderLength+udpHeaderLength+dnsLength)
+	packet[0] = 0x45
+	packet[9] = 17
+	copy(packet[12:16], sourceIP[:])
+	copy(packet[16:20], destinationIP[:])
+	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength:ipv4HeaderLength+2], sourcePort)
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength+2:ipv4HeaderLength+4], destinationPort)
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength+4:ipv4HeaderLength+6], uint16(udpHeaderLength+dnsLength))
+	dnsOffset := ipv4HeaderLength + udpHeaderLength
+	binary.BigEndian.PutUint16(packet[dnsOffset:], dnsID)
+	if response {
+		packet[dnsOffset+2] = 0x80
+	}
+	binary.BigEndian.PutUint16(packet[dnsOffset+4:dnsOffset+6], 1)
+	copy(packet[dnsOffset+12:], dnsQuestion)
+	return packet
+}
+
+func malformedShortDNSPacket(sourcePort, destinationPort, dnsID uint16) []byte {
+	const ipv4HeaderLength = 20
+	const udpHeaderLength = 8
+	packet := make([]byte, ipv4HeaderLength+udpHeaderLength+4)
+	packet[0] = 0x45
+	packet[9] = 17
+	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength:ipv4HeaderLength+2], sourcePort)
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength+2:ipv4HeaderLength+4], destinationPort)
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength+4:ipv4HeaderLength+6], udpHeaderLength+4)
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength+udpHeaderLength:], dnsID)
+	return packet
+}
+
+func newFakeRedundantTunnel(t *testing.T) (*fakeRealTUN, tun.Device, tun.Device, *RedundantTunnel) {
+	t.Helper()
+	real := newFakeRealTUN()
+	tunnel, err := NewRedundantTunnel(real)
+	if err != nil {
+		t.Fatalf("failed to create redundant tunnel: %v", err)
+	}
+	t.Cleanup(func() {
+		if err := tunnel.Close(); err != nil {
+			t.Errorf("failed to close redundant tunnel: %v", err)
+		}
+	})
+	slotA, err := tunnel.Slot(0)
+	if err != nil {
+		t.Fatalf("failed to get slot A: %v", err)
+	}
+	slotB, err := tunnel.Slot(1)
+	if err != nil {
+		t.Fatalf("failed to get slot B: %v", err)
+	}
+	return real, slotA, slotB, tunnel
+}
+
+func TestOutboundPacketsReachOnlyActiveSlot(t *testing.T) {
+	real, slotA, slotB, tunnel := newFakeRedundantTunnel(t)
+	packet := []byte{1, 2, 3}
+
+	real.injectOutbound(t, packet)
+	if got := readDevicePacket(t, slotA); string(got) != string(packet) {
+		t.Fatalf("active slot received %v, want %v", got, packet)
+	}
+
+	requireNoDevicePacketBeforeClose(t, slotB, func() error {
+		return tunnel.CloseSlot(1)
+	})
+}
+
+func TestInactiveInboundPacketsAreDropped(t *testing.T) {
+	real, _, slotB, _ := newFakeRedundantTunnel(t)
+
+	writeDevicePacket(t, slotB, []byte{4, 5, 6})
+	requireNoFakeRealTUNPacket(t, real)
+}
+
+func TestProbeReplyIsConsumedBeforeRealTun(t *testing.T) {
+	real, _, slotB, tunnel := newFakeRedundantTunnel(t)
+	token := ProbeToken{Port: 5353, DNSID: 7}
+	query := fakeDNSPacket(token.Port, 53, token.DNSID, false)
+	reply := fakeDNSPacket(53, token.Port, token.DNSID, true)
+
+	if err := tunnel.InjectProbe(1, query, token); err != nil {
+		t.Fatalf("failed to inject probe: %v", err)
+	}
+	if got := readDevicePacket(t, slotB); string(got) != string(query) {
+		t.Fatalf("standby slot received probe %v, want %v", got, query)
+	}
+	writeDevicePacket(t, slotB, reply)
+	requireNoFakeRealTUNPacket(t, real)
+	if !tunnel.ProbeSucceeded(token) {
+		t.Fatal("matching probe reply was not recorded")
+	}
+	writeDevicePacket(t, slotB, reply)
+	requireNoFakeRealTUNPacket(t, real)
+	if tunnel.ProbeSucceeded(token) {
+		t.Fatal("duplicate probe reply was reported twice")
+	}
+}
+
+func TestProbeReplyRequiresDNSResponseFromPort53(t *testing.T) {
+	real, _, slotB, tunnel := newFakeRedundantTunnel(t)
+	token := ProbeToken{Port: 5353, DNSID: 8}
+	query := fakeDNSPacket(token.Port, 53, token.DNSID, false)
+	wrongSourceReply := fakeDNSPacket(54, token.Port, token.DNSID, true)
+
+	if err := tunnel.InjectProbe(1, query, token); err != nil {
+		t.Fatalf("failed to inject probe: %v", err)
+	}
+	_ = readDevicePacket(t, slotB)
+	writeDevicePacket(t, slotB, wrongSourceReply)
+	requireNoFakeRealTUNPacket(t, real)
+	if tunnel.ProbeSucceeded(token) {
