+type fakeAdmissionBind struct {
+	fds          [2]int
+	fdErrors     [2]error
+	receiveCount int
+	sendCalls    int
+	closeCalls   int
+	closeErr     error
+}
+
+func (f *fakeAdmissionBind) Open(port uint16) ([]conn.ReceiveFunc, uint16, error) {
+	count := f.receiveCount
+	if count == 0 {
+		count = 2
+	}
+	receive := make([]conn.ReceiveFunc, count)
+	for index := range receive {
+		receive[index] = func(_ [][]byte, _ []int, _ []conn.Endpoint) (int, error) {
+			return 0, os.ErrClosed
+		}
+	}
+	return receive, port + 1, nil
+}
+
+func (f *fakeAdmissionBind) Close() error {
+	f.closeCalls++
+	return f.closeErr
+}
+
+func (f *fakeAdmissionBind) SetMark(uint32) error { return nil }
+
+func (f *fakeAdmissionBind) Send(_ [][]byte, _ conn.Endpoint) error {
+	f.sendCalls++
+	return nil
+}
+
+func (f *fakeAdmissionBind) ParseEndpoint(string) (conn.Endpoint, error) { return nil, nil }
+func (f *fakeAdmissionBind) BatchSize() int                              { return 1 }
+func (f *fakeAdmissionBind) PeekLookAtSocketFd4() (int, error) {
+	return f.fds[0], f.fdErrors[0]
+}
+func (f *fakeAdmissionBind) PeekLookAtSocketFd6() (int, error) {
+	return f.fds[1], f.fdErrors[1]
+}
+
+func requirePreparedSockets(t *testing.T, bind *admissionBind) admissionPreparedSockets {
+	t.Helper()
+	prepared, err := bind.PreparedSockets()
+	if err != nil {
+		t.Fatalf("discover prepared sockets: %v", err)
+	}
+	return prepared
+}
+
+func TestAdmissionBindRejectsPartialDescriptorDiscovery(t *testing.T) {
+	network := &fakeAdmissionBind{
+		fds:      [2]int{101, 102},
+		fdErrors: [2]error{nil, errors.New("forced IPv6 descriptor failure")},
+	}
+	bind := newAdmissionBind(func() conn.Bind { return network })
+	if _, _, err := bind.Open(0); err != nil {
+		t.Fatalf("prepare initial bind: %v", err)
