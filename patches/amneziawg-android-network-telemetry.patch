+func TestChannelTUNWriteRejectsOversizedPacket(t *testing.T) {
+	device := newChannelTUN(nil, 0, 1420, "bounded-write", 1, 1)
+	written, err := device.Write(
+		[][]byte{make([]byte, redundantTunnelMaxPacketSize+1)},
+		0,
