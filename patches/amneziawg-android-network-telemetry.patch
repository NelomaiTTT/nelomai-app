+func waitForProbeRegistration(
+	t *testing.T,
+	tunnel *RedundantTunnel,
+	token ProbeToken,
+	onTimeout func(),
+) {
+	t.Helper()
+	deadline := time.Now().Add(redundantTUNTestTimeout)
+	for {
+		tunnel.probeMu.Lock()
+		_, registered := tunnel.probes[token]
+		tunnel.probeMu.Unlock()
+		if registered {
+			return
+		}
+		if time.Now().After(deadline) {
+			onTimeout()
+			t.Fatal("probe was not registered before enqueue")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
