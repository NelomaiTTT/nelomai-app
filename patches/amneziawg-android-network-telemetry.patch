+func TestAdmissionBindAcceptsSingleNetworkFamily(t *testing.T) {
+	tests := []struct {
+		name string
+		bind *fakeAdmissionBind
+		want int
+	}{
+		{
+			name: "IPv4 only",
+			bind: &fakeAdmissionBind{
+				fds:          [2]int{101, -1},
+				fdErrors:     [2]error{nil, errors.New("IPv6 unavailable")},
+				receiveCount: 1,
+			},
+			want: 101,
+		},
+		{
+			name: "IPv6 only",
+			bind: &fakeAdmissionBind{
+				fds:          [2]int{-1, 102},
+				fdErrors:     [2]error{errors.New("IPv4 unavailable"), nil},
+				receiveCount: 1,
+			},
+			want: 102,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			bind := newAdmissionBind(func() conn.Bind { return test.bind })
+			if _, _, err := bind.Open(0); err != nil {
+				t.Fatalf("prepare initial bind: %v", err)
+			}
+			prepared := requirePreparedSockets(t, bind)
+			if len(prepared.FDs) != 1 || prepared.FDs[0] != test.want {
+				t.Fatalf("prepared descriptors are %v, want [%d]", prepared.FDs, test.want)
+			}
+		})
+	}
+}
