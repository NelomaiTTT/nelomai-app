@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestRedundantMetricsExcludeEndpointAndArbitraryErrorText(t *testing.T) {
+	snapshot := tunnelTelemetrySnapshot{
+		LastSendError: "private_key=send-secret",
+		LastRecvError: "private_key=receive-secret",
+		Endpoint:      "sensitive.example:51820",
+		LastSendErrno: 101,
+		LastRecvErrno: 113,
+	}
+	encoded, err := json.Marshal(redactRedundantTelemetry(snapshot))
+	if err != nil {
+		t.Fatalf("encode redundant telemetry: %v", err)
+	}
+	for _, forbidden := range []string{
+		"private_key",
+		"send-secret",
+		"receive-secret",
+		"sensitive.example",
+		"endpoint",
+		"last_udp_send_error",
+		"last_udp_receive_error",
+	} {
+		if strings.Contains(string(encoded), forbidden) {
+			t.Fatalf("redundant metrics exposed %q in %s", forbidden, encoded)
+		}
+	}
+	if !strings.Contains(string(encoded), `"last_udp_send_errno":101`) ||
+		!strings.Contains(string(encoded), `"last_udp_receive_errno":113`) {
+		t.Fatalf("redundant metrics lost bounded errno diagnostics: %s", encoded)
+	}
+}
diff --git a/tunnel/tools/libwg-go/redundant_tun.go b/tunnel/tools/libwg-go/redundant_tun.go
new file mode 100644
index 0000000000000000000000000000000000000000..3bc3b31bb125ebf73ccb8e5abe161a593a5fce94
--- /dev/null
+++ b/tunnel/tools/libwg-go/redundant_tun.go
@@ -0,0 +1,976 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+package main
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+)
+
+const (
+	redundantTunnelSlotCount       = 2
+	redundantTunnelQueueDepth      = 128
+	redundantTunnelMaxPacketSize   = 65_535
+	redundantTunnelMaxPendingProbe = 64
+	redundantTunnelProbeRetention  = time.Minute
+)
+
+var (
+	ErrRedundantTunnelClosed = errors.New("redundant tunnel is closed")
+	ErrRedundantSlotClosed   = errors.New("redundant tunnel slot is closed")
+	ErrInvalidRedundantSlot  = errors.New("invalid redundant tunnel slot")
+	ErrPacketQueueFull       = errors.New("redundant tunnel packet queue is full")
+	ErrPacketTooLarge        = errors.New("redundant tunnel packet exceeds maximum size")
+	ErrInvalidProbe          = errors.New("invalid redundant tunnel probe")
+	ErrProbeAlreadyPending   = errors.New("redundant tunnel probe is already pending")
+	ErrProbeLimitReached     = errors.New("redundant tunnel probe limit reached")
+)
+
+type monotonicHandleAllocator struct {
+	next atomic.Int64
+}
+
+func (a *monotonicHandleAllocator) Next() int64 {
+	identifier := a.next.Add(1)
+	if identifier <= 0 {
+		return -1
+	}
+	return identifier
+}
+
+// ProbeToken is the bounded tuple used to recognize one DNS dataplane reply.
+// The packet itself and its DNS payload are never retained after dispatch.
+type ProbeToken struct {
+	Port  uint16
+	DNSID uint16
+}
+
+type probeState struct {
+	slot      uint32
+	identity  probeIdentity
+	status    probeStatus
+	expiresAt time.Time
+}
+
+type probeStatus uint8
+
+const (
+	probePending probeStatus = iota
+	probeSucceeded
+	probeReported
+	probeCancelled
+)
+
+type probeIdentity struct {
+	ipVersion   uint8
+	sourceIP    [16]byte
+	destination [16]byte
+	question    string
+}
+
+type parsedDNSPacket struct {
+	sourcePort      uint16
+	destinationPort uint16
+	dnsID           uint16
+	response        bool
+	identity        probeIdentity
+}
+
+// RedundantTunnelCounters is a compact, non-secret dispatcher snapshot.
+type RedundantTunnelCounters struct {
+	OutboundPackets       uint64
+	OutboundDropped       uint64
+	InboundPackets        uint64
+	InactiveInboundDrops  uint64
+	ProbePacketsInjected  uint64
+	ProbeRepliesConsumed  uint64
+	ProbeInjectionDropped uint64
+	ActiveSwitches        uint64
+	SlotCloses            uint64
+}
+
+type redundantTunnelCounters struct {
+	outboundPackets       atomic.Uint64
+	outboundDropped       atomic.Uint64
+	inboundPackets        atomic.Uint64
+	inactiveInboundDrops  atomic.Uint64
+	probePacketsInjected  atomic.Uint64
+	probeRepliesConsumed  atomic.Uint64
+	probeInjectionDropped atomic.Uint64
+	activeSwitches        atomic.Uint64
+	slotCloses            atomic.Uint64
+}
+
+// RedundantTunnel owns the sole real TUN reader/writer and exposes two
+// independent channel-backed devices to cryptographic backend slots.
+type RedundantTunnel struct {
+	real   tun.Device
+	slots  [redundantTunnelSlotCount]*channelTUN
+	active atomic.Uint32
+	closed atomic.Bool
+	done   chan struct{}
+
+	routeMu   sync.RWMutex
+	probes    map[ProbeToken]probeState
+	probeMu   sync.Mutex
+	probeOpMu sync.Mutex
+
+	closeOnce sync.Once
+	closeMu   sync.Mutex
+	closeErr  error
+	wait      sync.WaitGroup
+	counters  redundantTunnelCounters
+}
+
+type channelTUN struct {
+	owner        *RedundantTunnel
+	index        uint32
+	mtu          int
+	name         string
+	batchSize    int
+	outbound     chan channelPacket
+	inbound      chan channelInboundPacket
+	events       chan tun.Event
+	done         chan struct{}
+	dispatchDone chan struct{}
+	stateMu      sync.Mutex
+	closedFlag   atomic.Bool
+	generation   atomic.Uint64
+}
+
+// slotAttachmentTUN gives one cryptographic backend an independently
+// cancellable view of a reusable dispatcher slot. Closing an attachment
+// satisfies tun.Device.Close without permanently closing the logical slot.
+type slotAttachmentTUN struct {
+	slot       *channelTUN
+	done       chan struct{}
+	events     chan tun.Event
+	closed     atomic.Bool
+	generation uint64
+	stateMu    sync.Mutex
+}
+
+type channelPacket struct {
+	payload    []byte
+	probe      bool
+	probeToken ProbeToken
+}
+
+type channelInboundPacket struct {
+	payload    []byte
+	generation uint64
+}
+
+// NewRedundantTunnel starts one dispatcher with slot A active by default.
+func NewRedundantTunnel(real tun.Device) (*RedundantTunnel, error) {
+	if real == nil {
+		return nil, errors.New("real TUN is required")
+	}
+	mtu, err := real.MTU()
+	if err != nil {
+		return nil, fmt.Errorf("read real TUN MTU: %w", err)
+	}
+	if mtu <= 0 || mtu > redundantTunnelMaxPacketSize {
+		return nil, fmt.Errorf("invalid real TUN MTU: %d", mtu)
+	}
+	batchSize := real.BatchSize()
+	if batchSize < 1 {
+		batchSize = 1
+	}
+	r := &RedundantTunnel{
+		real:   real,
+		done:   make(chan struct{}),
+		probes: make(map[ProbeToken]probeState),
+	}
+	for index := range r.slots {
+		r.slots[index] = newChannelTUN(
+			r,
+			uint32(index),
+			mtu,
+			fmt.Sprintf("redundant-slot-%d", index),
+			batchSize,
+			redundantTunnelQueueDepth,
+		)
+	}
+	r.wait.Add(1 + len(r.slots))
+	go r.dispatchOutbound()
+	for index := range r.slots {
+		go r.dispatchInbound(uint32(index), r.slots[index])
+	}
+	return r, nil
+}
+
+func newChannelTUN(
+	owner *RedundantTunnel,
+	index uint32,
+	mtu int,
+	name string,
+	batchSize, queueDepth int,
+) *channelTUN {
+	device := &channelTUN{
+		owner:        owner,
+		index:        index,
+		mtu:          mtu,
+		name:         name,
+		batchSize:    batchSize,
+		outbound:     make(chan channelPacket, queueDepth),
+		inbound:      make(chan channelInboundPacket, queueDepth),
+		events:       make(chan tun.Event, 1),
+		done:         make(chan struct{}),
+		dispatchDone: make(chan struct{}),
+	}
+	device.events <- tun.EventUp
+	return device
+}
+
+func (r *RedundantTunnel) Slot(slot uint32) (tun.Device, error) {
+	if slot >= uint32(len(r.slots)) {
+		return nil, ErrInvalidRedundantSlot
+	}
+	return r.slots[slot], nil
+}
+
+func (r *RedundantTunnel) AttachSlot(slot uint32) (tun.Device, error) {
+	device, err := r.Slot(slot)
+	if err != nil {
+		return nil, err
+	}
+	channel := device.(*channelTUN)
+	r.routeMu.Lock()
+	defer r.routeMu.Unlock()
+	if r.closed.Load() {
+		return nil, ErrRedundantTunnelClosed
+	}
+	if channel.closed() {
+		return nil, ErrRedundantSlotClosed
+	}
+	attachment := &slotAttachmentTUN{
+		slot:       channel,
+		done:       make(chan struct{}),
+		events:     make(chan tun.Event, 1),
+		generation: channel.generation.Add(1),
+	}
+	attachment.events <- tun.EventUp
+	return attachment, nil
+}
+
+func (r *RedundantTunnel) SwitchActive(slot uint32) error {
+	if slot >= uint32(len(r.slots)) {
+		return ErrInvalidRedundantSlot
+	}
+	if r.closed.Load() {
+		return ErrRedundantTunnelClosed
+	}
+	r.routeMu.Lock()
+	defer r.routeMu.Unlock()
+	if r.closed.Load() {
+		return ErrRedundantTunnelClosed
+	}
+	if r.slots[slot].closed() {
+		return ErrRedundantSlotClosed
+	}
+	previous := r.active.Swap(slot)
+	if previous != slot {
+		r.counters.outboundDropped.Add(r.slots[previous].dropQueuedUserPackets())
+		r.counters.activeSwitches.Add(1)
+	}
+	return nil
+}
+
+func (r *RedundantTunnel) InjectProbe(slot uint32, packet []byte, token ProbeToken) error {
+	r.probeOpMu.Lock()
+	defer r.probeOpMu.Unlock()
+	if slot >= uint32(len(r.slots)) {
+		return ErrInvalidRedundantSlot
+	}
+	if r.closed.Load() {
+		return ErrRedundantTunnelClosed
+	}
+	if r.slots[slot].closed() {
+		return ErrRedundantSlotClosed
+	}
+	if len(packet) == 0 || len(packet) > r.slots[slot].mtu {
+		return ErrInvalidProbe
+	}
+	identity, validProbe := probeQueryIdentity(packet, token)
+	if !validProbe {
+		return ErrInvalidProbe
+	}
+	now := time.Now()
+	r.probeMu.Lock()
+	r.pruneExpiredProbesLocked(now)
+	if _, exists := r.probes[token]; exists {
+		r.probeMu.Unlock()
+		return ErrProbeAlreadyPending
+	}
+	if len(r.probes) >= redundantTunnelMaxPendingProbe {
+		r.probeMu.Unlock()
+		return ErrProbeLimitReached
+	}
+	r.probes[token] = probeState{
+		slot:      slot,
+		identity:  identity,
+		status:    probePending,
+		expiresAt: now.Add(redundantTunnelProbeRetention),
+	}
+	r.probeMu.Unlock()
+
+	r.routeMu.RLock()
+	enqueued := !r.closed.Load() && !r.slots[slot].closed() &&
+		r.slots[slot].enqueueOutbound(packet, true, token)
+	r.routeMu.RUnlock()
+	if !enqueued {
+		r.probeMu.Lock()
+		delete(r.probes, token)
+		r.probeMu.Unlock()
+		r.counters.probeInjectionDropped.Add(1)
+		return ErrPacketQueueFull
+	}
+	r.counters.probePacketsInjected.Add(1)
+	return nil
+}
+
+// ProbeSucceeded returns and consumes one successful probe result. Pending
+// probes remain bounded until they succeed or the caller cancels them.
+func (r *RedundantTunnel) ProbeSucceeded(token ProbeToken) bool {
+	r.probeMu.Lock()
+	defer r.probeMu.Unlock()
+	now := time.Now()
+	r.pruneExpiredProbesLocked(now)
+	state, ok := r.probes[token]
+	if !ok || state.status != probeSucceeded {
+		return false
+	}
+	state.status = probeReported
+	state.expiresAt = now.Add(redundantTunnelProbeRetention)
+	r.probes[token] = state
+	return true
+}
+
+func (r *RedundantTunnel) CancelProbe(token ProbeToken) {
+	r.probeOpMu.Lock()
+	defer r.probeOpMu.Unlock()
+	r.probeMu.Lock()
+	now := time.Now()
+	r.pruneExpiredProbesLocked(now)
+	state, exists := r.probes[token]
+	if exists {
+		state.status = probeCancelled
+		state.expiresAt = now.Add(redundantTunnelProbeRetention)
+		r.probes[token] = state
+	}
+	r.probeMu.Unlock()
+	if exists {
+		r.slots[state.slot].dropQueuedProbe(token)
+	}
+}
+
+func (r *RedundantTunnel) CloseSlot(slot uint32) error {
+	if slot >= uint32(len(r.slots)) {
+		return ErrInvalidRedundantSlot
+	}
+	r.probeOpMu.Lock()
+	r.routeMu.Lock()
+	closedNow := r.slots[slot].closeTransition()
+	r.routeMu.Unlock()
+	if closedNow {
+		r.counters.slotCloses.Add(1)
+	}
+	r.probeMu.Lock()
+	for token, state := range r.probes {
+		if state.slot == slot {
+			delete(r.probes, token)
+		}
+	}
+	r.probeMu.Unlock()
+	r.probeOpMu.Unlock()
+	<-r.slots[slot].dispatchDone
+	return nil
+}
+
+// ResetSlot clears the ephemeral queues and probes left by a stopped backend
+// while keeping its channel TUN reusable for a replacement device.
+func (r *RedundantTunnel) ResetSlot(slot uint32) error {
+	if slot >= uint32(len(r.slots)) {
+		return ErrInvalidRedundantSlot
+	}
+	r.probeOpMu.Lock()
+	defer r.probeOpMu.Unlock()
+	if r.closed.Load() {
+		return ErrRedundantTunnelClosed
+	}
+	r.routeMu.Lock()
+	if r.slots[slot].closed() {
+		r.routeMu.Unlock()
+		return ErrRedundantSlotClosed
+	}
+	droppedUser, droppedProbes, droppedInbound := r.slots[slot].dropAllQueuedPackets()
+	r.routeMu.Unlock()
+	r.probeMu.Lock()
+	for token, state := range r.probes {
+		if state.slot == slot {
+			delete(r.probes, token)
+		}
+	}
+	r.probeMu.Unlock()
+	r.counters.outboundDropped.Add(droppedUser)
+	r.counters.probeInjectionDropped.Add(droppedProbes)
+	r.counters.inactiveInboundDrops.Add(droppedInbound)
+	return nil
+}
+
+func (r *RedundantTunnel) pruneExpiredProbesLocked(now time.Time) {
+	for token, state := range r.probes {
+		if !now.Before(state.expiresAt) {
+			delete(r.probes, token)
+		}
+	}
+}
+
+func (r *RedundantTunnel) Closed() bool {
+	return r.closed.Load()
+}
+
+func (r *RedundantTunnel) Counters() RedundantTunnelCounters {
+	return RedundantTunnelCounters{
+		OutboundPackets:       r.counters.outboundPackets.Load(),
+		OutboundDropped:       r.counters.outboundDropped.Load(),
+		InboundPackets:        r.counters.inboundPackets.Load(),
+		InactiveInboundDrops:  r.counters.inactiveInboundDrops.Load(),
+		ProbePacketsInjected:  r.counters.probePacketsInjected.Load(),
+		ProbeRepliesConsumed:  r.counters.probeRepliesConsumed.Load(),
+		ProbeInjectionDropped: r.counters.probeInjectionDropped.Load(),
+		ActiveSwitches:        r.counters.activeSwitches.Load(),
+		SlotCloses:            r.counters.slotCloses.Load(),
+	}
+}
+
+func (r *RedundantTunnel) Close() error {
+	r.closeWithError(nil)
+	r.wait.Wait()
+	r.closeMu.Lock()
+	defer r.closeMu.Unlock()
+	return r.closeErr
+}
+
+func (r *RedundantTunnel) closeWithError(cause error) {
+	r.probeOpMu.Lock()
+	defer r.probeOpMu.Unlock()
+	r.closeOnce.Do(func() {
+		r.closed.Store(true)
+		close(r.done)
+		for _, slot := range r.slots {
+			slot.closeTransition()
+		}
+		if err := r.real.Close(); cause == nil {
+			cause = err
+		}
+		r.probeMu.Lock()
+		clear(r.probes)
+		r.probeMu.Unlock()
+		r.closeMu.Lock()
+		r.closeErr = cause
+		r.closeMu.Unlock()
+	})
+}
+
+func (r *RedundantTunnel) dispatchOutbound() {
+	defer r.wait.Done()
+	batchSize := r.real.BatchSize()
+	if batchSize < 1 {
+		batchSize = 1
+	}
+	bufs := make([][]byte, batchSize)
+	sizes := make([]int, batchSize)
+	for index := range bufs {
+		bufs[index] = make([]byte, redundantTunnelMaxPacketSize)
+	}
+	for {
+		count, err := r.real.Read(bufs, sizes, 0)
+		if err != nil {
+			if r.closed.Load() || errors.Is(err, os.ErrClosed) {
+				return
+			}
+			r.closeWithError(fmt.Errorf("read real TUN: %w", err))
+			return
+		}
+		if count < 0 || count > len(bufs) || count > len(sizes) {
+			r.closeWithError(fmt.Errorf("real TUN returned invalid packet count: %d", count))
+			return
+		}
+		for index := 0; index < count; index++ {
+			if sizes[index] <= 0 || sizes[index] > len(bufs[index]) {
+				r.counters.outboundDropped.Add(1)
+				continue
+			}
+			r.routeMu.RLock()
+			active := r.active.Load()
+			slot := r.slots[active]
+			enqueued := !slot.closed() && slot.enqueueOutbound(
+				bufs[index][:sizes[index]],
+				false,
+				ProbeToken{},
+			)
+			r.routeMu.RUnlock()
+			if enqueued {
+				r.counters.outboundPackets.Add(1)
+			} else {
+				r.counters.outboundDropped.Add(1)
+			}
+		}
+	}
+}
+
+func (r *RedundantTunnel) dispatchInbound(slotIndex uint32, slot *channelTUN) {
+	defer r.wait.Done()
+	defer close(slot.dispatchDone)
+	for {
+		select {
+		case <-r.done:
+			return
+		case <-slot.done:
+			return
+		case packet := <-slot.inbound:
+			r.routeMu.RLock()
+			if r.closed.Load() || slot.closed() {
+				r.routeMu.RUnlock()
+				r.counters.inactiveInboundDrops.Add(1)
+				return
+			}
+			if packet.generation != slot.generation.Load() {
+				r.routeMu.RUnlock()
+				r.counters.inactiveInboundDrops.Add(1)
+				continue
+			}
+			if r.consumeProbeReply(slotIndex, packet.payload) {
+				r.routeMu.RUnlock()
+				continue
+			}
+			if r.active.Load() != slotIndex {
+				r.routeMu.RUnlock()
+				r.counters.inactiveInboundDrops.Add(1)
+				continue
+			}
+			_, err := r.real.Write([][]byte{packet.payload}, 0)
+			r.routeMu.RUnlock()
+			if err != nil {
+				if r.closed.Load() || errors.Is(err, os.ErrClosed) {
+					return
+				}
+				r.closeWithError(fmt.Errorf("write real TUN: %w", err))
+				return
+			}
+			r.counters.inboundPackets.Add(1)
+		}
+	}
+}
+
+func (r *RedundantTunnel) consumeProbeReply(slot uint32, packet []byte) bool {
+	parsed, ok := parseDNSPacket(packet)
+	if !ok || !parsed.response || parsed.sourcePort != 53 || parsed.destinationPort == 0 {
+		return false
+	}
+	token := ProbeToken{Port: parsed.destinationPort, DNSID: parsed.dnsID}
+	now := time.Now()
+	r.probeMu.Lock()
+	r.pruneExpiredProbesLocked(now)
+	state, exists := r.probes[token]
+	if !exists || state.slot != slot || !state.identity.matchesReply(parsed.identity) {
+		r.probeMu.Unlock()
+		return false
+	}
+	if state.status == probePending {
+		state.status = probeSucceeded
+		state.expiresAt = now.Add(redundantTunnelProbeRetention)
+		r.probes[token] = state
+	}
+	r.probeMu.Unlock()
+	r.counters.probeRepliesConsumed.Add(1)
+	return true
+}
+
+func probeQueryIdentity(packet []byte, token ProbeToken) (probeIdentity, bool) {
+	parsed, ok := parseDNSPacket(packet)
+	if !ok {
+		return probeIdentity{}, false
+	}
+	valid := !parsed.response && token.Port != 0 && parsed.sourcePort == token.Port &&
+		parsed.destinationPort == 53 && parsed.dnsID == token.DNSID
+	if !valid {
+		return probeIdentity{}, false
+	}
+	return parsed.identity, true
+}
+
+func (identity probeIdentity) matchesReply(reply probeIdentity) bool {
+	return identity.ipVersion == reply.ipVersion &&
+		identity.sourceIP == reply.destination &&
+		identity.destination == reply.sourceIP &&
+		identity.question == reply.question
+}
+
+func parseDNSPacket(packet []byte) (parsedDNSPacket, bool) {
+	if len(packet) < 1 {
+		return parsedDNSPacket{}, false
+	}
+	var (
+		udpOffset     int
+		networkLength int
+		identity      probeIdentity
+	)
+	switch packet[0] >> 4 {
+	case 4:
+		if len(packet) < 20 {
+			return parsedDNSPacket{}, false
+		}
+		headerLength := int(packet[0]&0x0f) * 4
+		networkLength = int(binary.BigEndian.Uint16(packet[2:4]))
+		fragment := binary.BigEndian.Uint16(packet[6:8])
+		if headerLength < 20 || networkLength != len(packet) ||
+			networkLength < headerLength+20 || packet[9] != 17 || fragment&0x3fff != 0 {
+			return parsedDNSPacket{}, false
+		}
+		udpOffset = headerLength
+		identity.ipVersion = 4
+		copy(identity.sourceIP[:4], packet[12:16])
+		copy(identity.destination[:4], packet[16:20])
+	case 6:
+		if len(packet) < 60 || packet[6] != 17 {
+			return parsedDNSPacket{}, false
+		}
+		networkLength = 40 + int(binary.BigEndian.Uint16(packet[4:6]))
+		if networkLength != len(packet) {
+			return parsedDNSPacket{}, false
+		}
+		udpOffset = 40
+		identity.ipVersion = 6
+		copy(identity.sourceIP[:], packet[8:24])
+		copy(identity.destination[:], packet[24:40])
+	default:
+		return parsedDNSPacket{}, false
+	}
+	udpLength := int(binary.BigEndian.Uint16(packet[udpOffset+4 : udpOffset+6]))
+	if udpLength < 20 || udpOffset+udpLength != networkLength {
+		return parsedDNSPacket{}, false
+	}
+	dnsPayload := packet[udpOffset+8 : udpOffset+udpLength]
+	question, response, ok := parseDNSQuestion(dnsPayload)
+	if !ok {
+		return parsedDNSPacket{}, false
+	}
+	identity.question = question
+	return parsedDNSPacket{
+		sourcePort:      binary.BigEndian.Uint16(packet[udpOffset : udpOffset+2]),
+		destinationPort: binary.BigEndian.Uint16(packet[udpOffset+2 : udpOffset+4]),
+		dnsID:           binary.BigEndian.Uint16(dnsPayload[:2]),
+		response:        response,
+		identity:        identity,
+	}, true
+}
+
+func parseDNSQuestion(payload []byte) (string, bool, bool) {
+	if len(payload) < 12 {
+		return "", false, false
+	}
+	flags := binary.BigEndian.Uint16(payload[2:4])
+	if flags&0x7800 != 0 || binary.BigEndian.Uint16(payload[4:6]) != 1 {
+		return "", false, false
+	}
+	position := 12
+	normalized := make([]byte, 0, 64)
+	for {
+		if position >= len(payload) {
+			return "", false, false
+		}
+		labelLength := int(payload[position])
+		position++
+		if labelLength&0xc0 != 0 || labelLength > 63 || position+labelLength > len(payload) {
+			return "", false, false
+		}
+		normalized = append(normalized, byte(labelLength))
+		if labelLength == 0 {
+			break
+		}
+		for _, value := range payload[position : position+labelLength] {
+			if value >= 'A' && value <= 'Z' {
+				value += 'a' - 'A'
+			}
+			normalized = append(normalized, value)
+		}
+		position += labelLength
+	}
+	if position+4 > len(payload) {
+		return "", false, false
+	}
+	normalized = append(normalized, payload[position:position+4]...)
+	return string(normalized), flags&0x8000 != 0, true
+}
+
+func (c *channelTUN) File() *os.File { return nil }
+
+func (c *channelTUN) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	return c.readWithCancel(bufs, sizes, offset, nil)
+}
+
+func (c *channelTUN) readWithCancel(
+	bufs [][]byte,
+	sizes []int,
+	offset int,
+	cancel <-chan struct{},
+) (int, error) {
+	if len(bufs) == 0 || len(sizes) < len(bufs) || offset < 0 {
+		return 0, errors.New("invalid channel TUN read buffers")
+	}
+	select {
+	case <-c.done:
+		return 0, os.ErrClosed
+	case <-cancel:
+		return 0, os.ErrClosed
+	default:
+	}
+	var first channelPacket
+	select {
+	case <-c.done:
+		return 0, os.ErrClosed
+	case <-cancel:
+		return 0, os.ErrClosed
+	case first = <-c.outbound:
+	}
+	c.stateMu.Lock()
+	defer c.stateMu.Unlock()
+	if c.closedFlag.Load() || channelClosed(cancel) {
+		return 0, os.ErrClosed
+	}
+	packets := 0
+	for packets < len(bufs) {
+		packet := first.payload
+		if packets > 0 {
+			var queued channelPacket
+			select {
+			case queued = <-c.outbound:
+			default:
+				return packets, nil
+			}
+			packet = queued.payload
+		}
+		if offset+len(packet) > len(bufs[packets]) {
+			if packets == 0 {
+				return 0, errors.New("channel TUN read buffer is too small")
+			}
+			return packets, nil
+		}
+		copy(bufs[packets][offset:], packet)
+		sizes[packets] = len(packet)
+		packets++
+	}
+	return packets, nil
+}
+
+func channelClosed(channel <-chan struct{}) bool {
+	select {
+	case <-channel:
+		return true
+	default:
+		return false
+	}
+}
+
+func (c *channelTUN) Write(bufs [][]byte, offset int) (int, error) {
+	return c.writeWithGeneration(bufs, offset, c.generation.Load())
+}
+
+func (c *channelTUN) writeWithGeneration(
+	bufs [][]byte,
+	offset int,
+	generation uint64,
+) (int, error) {
+	if offset < 0 {
+		return 0, errors.New("invalid channel TUN write offset")
+	}
+	if c.closed() {
+		return 0, os.ErrClosed
+	}
+	for index, buffer := range bufs {
+		if offset > len(buffer) {
+			return index, errors.New("invalid channel TUN write buffer")
+		}
+		packetSize := len(buffer) - offset
+		if packetSize > redundantTunnelMaxPacketSize {
+			return index, ErrPacketTooLarge
+		}
+		c.stateMu.Lock()
+		if c.closedFlag.Load() || generation != c.generation.Load() {
+			c.stateMu.Unlock()
+			return index, os.ErrClosed
+		}
+		if len(c.inbound) == cap(c.inbound) {
+			c.stateMu.Unlock()
+			return index, ErrPacketQueueFull
+		}
+		packet := channelInboundPacket{
+			payload:    append([]byte(nil), buffer[offset:]...),
+			generation: generation,
+		}
+		select {
+		case c.inbound <- packet:
+			c.stateMu.Unlock()
+		default:
+			c.stateMu.Unlock()
+			return index, ErrPacketQueueFull
+		}
+	}
+	return len(bufs), nil
+}
+
+func (c *channelTUN) MTU() (int, error)        { return c.mtu, nil }
+func (c *channelTUN) Name() (string, error)    { return c.name, nil }
+func (c *channelTUN) Events() <-chan tun.Event { return c.events }
+func (c *channelTUN) BatchSize() int           { return c.batchSize }
+
+func (c *channelTUN) Close() error {
+	return c.owner.CloseSlot(c.index)
+}
+
+func (c *channelTUN) closeTransition() bool {
+	c.stateMu.Lock()
+	defer c.stateMu.Unlock()
+	if c.closedFlag.Load() {
+		return false
+	}
+	c.closedFlag.Store(true)
+	close(c.done)
+	close(c.events)
+	return true
+}
+
+func (c *channelTUN) enqueueOutbound(packet []byte, probe bool, token ProbeToken) bool {
+	queued := channelPacket{
+		payload:    append([]byte(nil), packet...),
+		probe:      probe,
+		probeToken: token,
+	}
+	c.stateMu.Lock()
+	defer c.stateMu.Unlock()
+	if c.closedFlag.Load() {
+		return false
+	}
+	select {
+	case c.outbound <- queued:
+		return true
+	default:
+		return false
+	}
+}
+
+func (c *channelTUN) dropQueuedUserPackets() uint64 {
+	c.stateMu.Lock()
+	defer c.stateMu.Unlock()
+	preserved := make([]channelPacket, 0, len(c.outbound))
+	dropped := uint64(0)
+	for {
+		select {
+		case packet := <-c.outbound:
+			if packet.probe {
+				preserved = append(preserved, packet)
+			} else {
+				dropped++
+			}
+		default:
+			for _, packet := range preserved {
+				c.outbound <- packet
+			}
+			return dropped
+		}
+	}
+}
+
+func (c *channelTUN) dropAllQueuedPackets() (uint64, uint64, uint64) {
+	c.stateMu.Lock()
+	defer c.stateMu.Unlock()
+	var userPackets, probes, inbound uint64
+	for {
+		select {
+		case packet := <-c.outbound:
+			if packet.probe {
+				probes++
+			} else {
+				userPackets++
+			}
+		default:
+			for {
+				select {
+				case <-c.inbound:
+					inbound++
+				default:
+					return userPackets, probes, inbound
+				}
+			}
+		}
+	}
+}
+
+func (c *channelTUN) dropQueuedProbe(token ProbeToken) {
+	c.stateMu.Lock()
+	defer c.stateMu.Unlock()
+	preserved := make([]channelPacket, 0, len(c.outbound))
+	for {
+		select {
+		case packet := <-c.outbound:
+			if !packet.probe || packet.probeToken != token {
+				preserved = append(preserved, packet)
+			}
+		default:
+			for _, packet := range preserved {
+				c.outbound <- packet
+			}
+			return
+		}
+	}
+}
+
+func (c *channelTUN) closed() bool {
+	return c.closedFlag.Load()
+}
+
+func (a *slotAttachmentTUN) File() *os.File { return nil }
+
+func (a *slotAttachmentTUN) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	return a.slot.readWithCancel(bufs, sizes, offset, a.done)
+}
+
+func (a *slotAttachmentTUN) Write(bufs [][]byte, offset int) (int, error) {
+	a.stateMu.Lock()
+	defer a.stateMu.Unlock()
+	if a.closed.Load() {
+		return 0, os.ErrClosed
+	}
+	return a.slot.writeWithGeneration(bufs, offset, a.generation)
+}
+
+func (a *slotAttachmentTUN) MTU() (int, error)     { return a.slot.MTU() }
+func (a *slotAttachmentTUN) Name() (string, error) { return a.slot.Name() }
+func (a *slotAttachmentTUN) Events() <-chan tun.Event {
+	return a.events
+}
+func (a *slotAttachmentTUN) BatchSize() int { return a.slot.BatchSize() }
+
+func (a *slotAttachmentTUN) Close() error {
+	a.stateMu.Lock()
+	defer a.stateMu.Unlock()
+	if a.closed.Swap(true) {
+		return nil
+	}
+	close(a.done)
+	close(a.events)
+	a.slot.generation.CompareAndSwap(a.generation, a.generation+1)
+	a.slot.owner.routeMu.Lock()
+	a.slot.owner.routeMu.Unlock()
+	return nil
+}
