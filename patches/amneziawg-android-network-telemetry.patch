index 00000000..03be0804
--- /dev/null
+++ b/tunnel/tools/libwg-go/redundant_probe_test.go
@@ -0,0 +1,171 @@
+package main
+
+import (
+	"encoding/binary"
+	"testing"
+	"time"
+)
+
+func TestRedundantProbeRegistryConsumesOneSuccessfulReply(t *testing.T) {
+	real, _, slotB, tunnel := newFakeRedundantTunnel(t)
+	registry := newRedundantProbeRegistry(tunnel)
+	opaque := registry.Start(1, "10.200.0.2/32", "8.8.8.8", "nelomai.ru")
+	if opaque <= 0 {
+		t.Fatal("probe start failed")
+	}
+	if status := registry.Status(opaque); status != redundantProbePending {
+		t.Fatalf("initial status = %d, want pending", status)
+	}
+	query := readDevicePacket(t, slotB)
+	writeDevicePacket(t, slotB, dnsProbeReply(query))
+	requireNoFakeRealTUNPacket(t, real)
+	if status := registry.Status(opaque); status != redundantProbeSucceeded {
+		t.Fatalf("reply status = %d, want succeeded", status)
+	}
+	if status := registry.Status(opaque); status != redundantProbeUnknown {
+		t.Fatalf("terminal token reuse = %d, want unknown", status)
+	}
+}
+
+func TestRedundantProbeRegistryRejectsWrongTupleAndCancelsTimeout(t *testing.T) {
+	_, _, slotB, tunnel := newFakeRedundantTunnel(t)
+	registry := newRedundantProbeRegistry(tunnel)
+	opaque := registry.Start(1, "10.200.0.2/32", "8.8.8.8", "nelomai.ru")
+	query := readDevicePacket(t, slotB)
+	reply := dnsProbeReply(query)
+	binary.BigEndian.PutUint16(reply[30:32], binary.BigEndian.Uint16(reply[30:32])+1)
+	recomputeProbeChecksums(reply)
+	writeDevicePacket(t, slotB, reply)
+	if status := registry.Status(opaque); status != redundantProbePending {
+		t.Fatalf("wrong tuple status = %d, want pending", status)
+	}
+	if !registry.Cancel(opaque) {
+		t.Fatal("timeout cancellation failed")
+	}
+	if status := registry.Status(opaque); status != redundantProbeUnknown {
+		t.Fatalf("cancelled status = %d, want unknown", status)
+	}
+}
+
+func TestRedundantProbeRegistryFailsAndConsumesAnAbandonedToken(t *testing.T) {
+	_, _, slotB, tunnel := newFakeRedundantTunnel(t)
+	registry := newRedundantProbeRegistry(tunnel)
+	now := time.Unix(1_700_000_000, 0)
+	registry.now = func() time.Time { return now }
+	opaque := registry.Start(1, "10.200.0.2/32", "8.8.8.8", "nelomai.ru")
+	_ = readDevicePacket(t, slotB)
+	now = now.Add(redundantTunnelProbeRetention)
+
+	if status := registry.Status(opaque); status != redundantProbeFailed {
+		t.Fatalf("expired status = %d, want failed", status)
+	}
+	if status := registry.Status(opaque); status != redundantProbeUnknown {
+		t.Fatalf("failed token reuse = %d, want unknown", status)
+	}
+}
+
+func TestRedundantProbeRegistryValidatesSlotAndTemplate(t *testing.T) {
+	_, _, _, tunnel := newFakeRedundantTunnel(t)
+	registry := newRedundantProbeRegistry(tunnel)
+	invalid := [][4]string{
+		{"2", "10.200.0.2/32", "8.8.8.8", "nelomai.ru"},
+		{"1", "10.200.0.2/24", "8.8.8.8", "nelomai.ru"},
+		{"1", "10.200.0.2/32", "2001:db8::1", "nelomai.ru"},
+		{"1", "10.200.0.2/32", "8.8.8.8", "Nelomai.ru"},
+		{"1", "10.200.0.2/32", "8.8.8.8", "nelomai.ru."},
+	}
+	for _, values := range invalid {
+		slot := int32(values[0][0] - '0')
+		if token := registry.Start(slot, values[1], values[2], values[3]); token != -1 {
+			t.Fatalf("malformed template returned token %d for %v", token, values)
+		}
+	}
+}
+
+func TestRedundantProbeRegistryCancelsOnlyTheSelectedSlot(t *testing.T) {
+	_, slotA, slotB, tunnel := newFakeRedundantTunnel(t)
+	registry := newRedundantProbeRegistry(tunnel)
+	first := registry.Start(0, "10.200.0.2/32", "8.8.8.8", "nelomai.ru")
+	second := registry.Start(1, "10.200.0.2/32", "8.8.4.4", "nelomai.ru")
+	_ = readDevicePacket(t, slotA)
+	_ = readDevicePacket(t, slotB)
+
+	registry.CancelSlot(1)
+
+	if status := registry.Status(first); status != redundantProbePending {
+		t.Fatalf("other slot status = %d, want pending", status)
+	}
+	if status := registry.Status(second); status != redundantProbeUnknown {
+		t.Fatalf("cancelled slot status = %d, want unknown", status)
+	}
+}
+
+func TestRedundantProbeRegistryRejectsDuplicateLiveOpaqueToken(t *testing.T) {
+	_, slotA, slotB, tunnel := newFakeRedundantTunnel(t)
+	registry := newRedundantProbeRegistry(tunnel)
+	first := registry.Start(0, "10.200.0.2/32", "8.8.8.8", "nelomai.ru")
+	_ = readDevicePacket(t, slotA)
+	registry.allocator.next.Store(0)
+
+	if second := registry.Start(1, "10.200.0.2/32", "8.8.4.4", "nelomai.ru"); second != -1 {
+		t.Fatalf("duplicate opaque token returned %d", second)
+	}
+	select {
+	case packet := <-slotB.(*channelTUN).outbound:
+		t.Fatalf("duplicate token retained queued packet: %v", packet.payload)
+	default:
+	}
+	if status := registry.Status(first); status != redundantProbePending {
+		t.Fatalf("original token status = %d, want pending", status)
+	}
+}
+
+func TestRedundantProbeRegistryRejectsClosedSession(t *testing.T) {
+	_, _, _, tunnel := newFakeRedundantTunnel(t)
+	registry := newRedundantProbeRegistry(tunnel)
+	if err := tunnel.Close(); err != nil {
+		t.Fatalf("close tunnel: %v", err)
+	}
+	if token := registry.Start(0, "10.200.0.2/32", "8.8.8.8", "nelomai.ru"); token != -1 {
+		t.Fatalf("closed session returned token %d", token)
+	}
+}
+
+func TestBuiltDNSProbeHasValidIPv4AndUDPChecksums(t *testing.T) {
+	source, _ := canonicalProbeSourceIPv4("10.200.0.2/32")
+	target, _ := canonicalProbeTargetIPv4("8.8.8.8")
+	packet := buildIPv4DNSProbe(source, target, "nelomai.ru", ProbeToken{Port: 5353, DNSID: 7})
+	if internetChecksum(packet[:20]) != 0 {
+		t.Fatal("invalid IPv4 checksum")
+	}
+	if udpIPv4Checksum(source, target, packet[20:]) != 0 {
+		t.Fatal("invalid UDP checksum")
+	}
+}
+
+func dnsProbeReply(query []byte) []byte {
+	reply := append([]byte(nil), query...)
+	source := append([]byte(nil), reply[12:16]...)
+	copy(reply[12:16], reply[16:20])
+	copy(reply[16:20], source)
+	sourcePort := binary.BigEndian.Uint16(reply[20:22])
+	binary.BigEndian.PutUint16(reply[20:22], 53)
+	binary.BigEndian.PutUint16(reply[22:24], sourcePort)
+	reply[30] |= 0x80
+	recomputeProbeChecksums(reply)
+	return reply
+}
+
+func recomputeProbeChecksums(packet []byte) {
+	packet[10], packet[11] = 0, 0
+	packet[26], packet[27] = 0, 0
+	binary.BigEndian.PutUint16(packet[10:12], internetChecksum(packet[:20]))
+	var source, target [4]byte
+	copy(source[:], packet[12:16])
+	copy(target[:], packet[16:20])
+	checksum := udpIPv4Checksum(source, target, packet[20:])
+	if checksum == 0 {
+		checksum = 0xffff
+	}
+	binary.BigEndian.PutUint16(packet[26:28], checksum)
+}
diff --git a/tunnel/tools/libwg-go/redundant_real_writer.go b/tunnel/tools/libwg-go/redundant_real_writer.go
new file mode 100644
index 00000000..2e203c34
--- /dev/null
+++ b/tunnel/tools/libwg-go/redundant_real_writer.go
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+package main
+
+import (
+	"errors"
+	"io"
+	"os"
+	"sync"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+)
+
+var ErrRedundantWriterWouldBlock = errors.New("redundant real TUN writer would block")
+
+// redundantRealWriter is deliberately packet-scoped. Implementations must not
+// serialize an active slot behind another slot's in-flight write.
+type redundantRealWriter interface {
+	WritePacket(packet []byte) error
+	Close() error
+}
+
+type redundantTunDeviceWriter struct {
+	device tun.Device
+}
+
+func (w *redundantTunDeviceWriter) WritePacket(packet []byte) error {
+	written, err := w.device.Write([][]byte{packet}, 0)
+	if err != nil {
+		return err
+	}
+	if written != 1 {
+		return io.ErrShortWrite
+	}
+	return nil
+}
+
+// The wrapped tun.Device remains owned and closed by RedundantTunnel.
+func (w *redundantTunDeviceWriter) Close() error { return nil }
+
+// redundantWriterFDGate keeps an owned descriptor alive across every admitted
+// non-blocking write. The read lock permits concurrent slot writes; close takes
+// the exclusive side before releasing the descriptor number to the process.
+type redundantWriterFDGate struct {
+	mu sync.RWMutex
+	fd int
+}
+
+func newRedundantWriterFDGate(fd int) *redundantWriterFDGate {
+	return &redundantWriterFDGate{fd: fd}
+}
+
+func (g *redundantWriterFDGate) withFD(use func(int) error) error {
+	g.mu.RLock()
+	defer g.mu.RUnlock()
+	if g.fd < 0 {
+		return os.ErrClosed
+	}
+	return use(g.fd)
+}
+
+func (g *redundantWriterFDGate) closeFD(closeDescriptor func(int) error) error {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.fd < 0 {
+		return nil
+	}
+	fd := g.fd
+	g.fd = -1
+	return closeDescriptor(fd)
+}
+
+func normalizeRedundantWriterError(err error) error {
+	if errors.Is(err, os.ErrClosed) {
+		return os.ErrClosed
+	}
+	return err
+}
diff --git a/tunnel/tools/libwg-go/redundant_real_writer_android.go b/tunnel/tools/libwg-go/redundant_real_writer_android.go
new file mode 100644
index 00000000..1a2fc7ed
--- /dev/null
+++ b/tunnel/tools/libwg-go/redundant_real_writer_android.go
@@ -0,0 +1,59 @@
+//go:build android
+
+/* SPDX-License-Identifier: Apache-2.0 */
+
+package main
+
+import (
+	"errors"
+	"io"
+	"os"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+	"golang.org/x/sys/unix"
+)
+
+type redundantAndroidRealWriter struct {
+	gate *redundantWriterFDGate
+}
+
+func newRedundantRealWriter(real tun.Device) (redundantRealWriter, error) {
+	file := real.File()
+	if file == nil {
+		return nil, errors.New("real TUN has no file descriptor")
+	}
+	fd, err := unix.Dup(int(file.Fd()))
+	if err != nil {
+		return nil, err
+	}
+	if err := unix.SetNonblock(fd, true); err != nil {
+		_ = unix.Close(fd)
+		return nil, err
+	}
+	return &redundantAndroidRealWriter{
+		gate: newRedundantWriterFDGate(fd),
+	}, nil
+}
+
+func (w *redundantAndroidRealWriter) WritePacket(packet []byte) error {
+	return w.gate.withFD(func(fd int) error {
+		written, err := unix.Write(fd, packet)
+		if errors.Is(err, unix.EAGAIN) || errors.Is(err, unix.EWOULDBLOCK) {
+			return ErrRedundantWriterWouldBlock
+		}
+		if errors.Is(err, unix.EBADF) {
+			return os.ErrClosed
+		}
+		if err != nil {
+			return err
+		}
+		if written != len(packet) {
+			return io.ErrShortWrite
+		}
+		return nil
+	})
+}
+
+func (w *redundantAndroidRealWriter) Close() error {
+	return w.gate.closeFD(unix.Close)
+}
