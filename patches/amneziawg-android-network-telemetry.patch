+type diagnosticBind struct {
+	conn.Bind
+	telemetry *tunnelTelemetry
+}
+
+func (d *diagnosticBind) Open(port uint16) ([]conn.ReceiveFunc, uint16, error) {
+	functions, actualPort, err := d.Bind.Open(port)
+	if err == nil {
+		d.telemetry.localPort.Store(uint32(actualPort))
+	} else {
+		d.telemetry.localPort.Store(0)
+		d.telemetry.udpRecvErrors.Add(1)
+		d.telemetry.lastRecvError.Store(diagnosticError(err))
+		d.telemetry.lastRecvErrno.Store(int64(diagnosticErrno(err)))
+	}
+	if err != nil {
+		return functions, actualPort, err
+	}
+	wrapped := make([]conn.ReceiveFunc, len(functions))
+	for i, receive := range functions {
+		receive := receive
+		wrapped[i] = func(packets [][]byte, sizes []int, endpoints []conn.Endpoint) (int, error) {
+			n, receiveErr := receive(packets, sizes, endpoints)
+			var bytes uint64
+			var endpoint conn.Endpoint
+			for index := 0; index < n && index < len(sizes); index++ {
+				if sizes[index] > 0 {
+					bytes += uint64(sizes[index])
+				}
+				if endpoint == nil && index < len(endpoints) && endpoints[index] != nil {
+					endpoint = endpoints[index]
+				}
+			}
+			d.telemetry.udpRecvCalls.Add(1)
+			d.telemetry.udpRecvPackets.Add(uint64(max(n, 0)))
+			d.telemetry.udpRecvBytes.Add(bytes)
+			var now int64
+			if n > 0 {
+				now = nowUnixMillis()
+				d.telemetry.lastUdpRecvAt.Store(now)
+			}
+			if endpoint != nil && d.telemetry.shouldCaptureEndpoint(now) {
+				d.telemetry.endpoint.Store(endpoint.DstToString())
+			}
+			if receiveErr != nil && !errors.Is(receiveErr, net.ErrClosed) {
+				d.telemetry.udpRecvErrors.Add(1)
+				d.telemetry.lastRecvError.Store(diagnosticError(receiveErr))
+				d.telemetry.lastRecvErrno.Store(int64(diagnosticErrno(receiveErr)))
+			}
+			return n, receiveErr
+		}
+	}
+	return wrapped, actualPort, nil
+}
+
+func (d *diagnosticBind) Send(bufs [][]byte, endpoint conn.Endpoint) error {
+	var bytes uint64
+	for _, buffer := range bufs {
+		bytes += uint64(len(buffer))
+	}
+	err := d.Bind.Send(bufs, endpoint)
+	d.telemetry.udpSendCalls.Add(1)
+	now := nowUnixMillis()
+	d.telemetry.lastUdpSendAt.Store(now)
+	if endpoint != nil && d.telemetry.shouldCaptureEndpoint(now) {
+		d.telemetry.endpoint.Store(endpoint.DstToString())
+	}
+	if err != nil {
+		d.telemetry.udpSendErrors.Add(1)
+		d.telemetry.lastSendError.Store(diagnosticError(err))
+		d.telemetry.lastSendErrno.Store(int64(diagnosticErrno(err)))
+	} else {
+		d.telemetry.udpSendPackets.Add(uint64(len(bufs)))
+		d.telemetry.udpSendBytes.Add(bytes)
+	}
+	return err
+}
