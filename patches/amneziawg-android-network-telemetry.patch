+func TestConcurrentDuplicateSlotCloseCountedOnce(t *testing.T) {
+	_, _, _, tunnel := newFakeRedundantTunnel(t)
+	start := make(chan struct{})
+	var wait sync.WaitGroup
+	for range 64 {
+		wait.Add(1)
+		go func() {
+			defer wait.Done()
+			<-start
+			if err := tunnel.CloseSlot(1); err != nil {
+				t.Errorf("failed to close standby slot: %v", err)
