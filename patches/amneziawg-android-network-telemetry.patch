+func (d *diagnosticTun) Write(bufs [][]byte, offset int) (int, error) {
+	n, err := d.Device.Write(bufs, offset)
+	var bytes uint64
+	var packets uint64
+	if err == nil {
+		for _, buffer := range bufs {
+			if len(buffer) > offset {
+				bytes += uint64(len(buffer) - offset)
+				packets++
+			}
+		}
+	} else if n > 0 {
+		// Android's native TUN returns the number of bytes written on partial success.
+		bytes = uint64(n)
+		// NativeTun exposes only the total bytes written on an error. A positive
+		// total guarantees at least one complete TUN packet, but not its exact count.
+		packets = 1
+	}
+	d.telemetry.tunWritePackets.Add(packets)
+	d.telemetry.tunWriteBytes.Add(bytes)
+	if n > 0 {
+		d.telemetry.lastTunWriteAt.Store(nowUnixMillis())
+	}
+	if err != nil {
+		d.telemetry.tunWriteErrors.Add(1)
+	}
+	return n, err
+}
