diff --git a/tunnel/tools/libwg-go/admission_bind.go b/tunnel/tools/libwg-go/admission_bind.go
new file mode 100644
index 0000000000000000000000000000000000000000..41d0650a68f39668e6d2b412704fe182887260b4
--- /dev/null
+++ b/tunnel/tools/libwg-go/admission_bind.go
@@ -0,0 +1,345 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+package main
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"sync"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/conn"
+)
+
+var (
+	errAdmissionBindClosed     = errors.New("admission bind is closed")
+	errAdmissionBindNotPending = errors.New("admission bind has no prepared socket set")
+	errAdmissionBindBusy       = errors.New("admission bind already has a prepared socket set")
+	errAdmissionBindGeneration = errors.New("admission bind preparation generation changed")
+)
+
+type admissionPreparedSockets struct {
+	Token uint64
+	FDs   []int
+}
+
+type admissionBindGeneration struct {
+	bind       conn.Bind
+	receive    []conn.ReceiveFunc
+	generation uint64
+	actualPort uint16
+}
+
+// admissionBind keeps newly opened sockets unable to send or deliver packets
+// until Android has synchronously protected every descriptor.
+type admissionBind struct {
+	mu      sync.Mutex
+	changed *sync.Cond
+	factory func() conn.Bind
+	parser  conn.Bind
+
+	active      *admissionBindGeneration
+	pending     *admissionBindGeneration
+	next        uint64
+	receiveSize int
+	mark        uint32
+	closed      bool
+
+	endpointGenerations sync.Map
+}
+
+func newAdmissionBind(factory func() conn.Bind) *admissionBind {
+	bind := &admissionBind{
+		factory: factory,
+		parser:  conn.NewStdNetBind(),
+	}
+	bind.changed = sync.NewCond(&bind.mu)
+	return bind
+}
+
+func (a *admissionBind) Open(port uint16) ([]conn.ReceiveFunc, uint16, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.closed {
+		return nil, 0, errAdmissionBindClosed
+	}
+	if a.active != nil || a.pending != nil || a.receiveSize != 0 {
+		return nil, 0, conn.ErrBindAlreadyOpen
+	}
+	generation, actualPort, err := a.prepareLocked(port)
+	if err != nil {
+		return nil, 0, err
+	}
+	a.receiveSize = len(generation.receive)
+	stable := make([]conn.ReceiveFunc, a.receiveSize)
+	for index := range stable {
+		index := index
+		stable[index] = func(
+			packets [][]byte,
+			sizes []int,
+			endpoints []conn.Endpoint,
+		) (int, error) {
+			return a.receive(index, packets, sizes, endpoints)
+		}
+	}
+	return stable, actualPort, nil
+}
+
+func (a *admissionBind) PrepareRebind(port uint16) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.closed {
+		return errAdmissionBindClosed
+	}
+	if a.active == nil {
+		return fmt.Errorf("active admission bind is required")
+	}
+	if a.pending != nil {
+		return errAdmissionBindBusy
+	}
+	generation, _, err := a.prepareLocked(port)
+	if err != nil {
+		return err
+	}
+	if len(generation.receive) != a.receiveSize {
+		a.pending = nil
+		_ = generation.bind.Close()
+		return fmt.Errorf(
+			"rebound receive function count changed from %d to %d",
+			a.receiveSize,
+			len(generation.receive),
+		)
+	}
+	return nil
+}
+
+func (a *admissionBind) prepareLocked(port uint16) (*admissionBindGeneration, uint16, error) {
+	if a.factory == nil {
+		return nil, 0, errors.New("admission bind factory is required")
+	}
+	prepared := a.factory()
+	if prepared == nil {
+		return nil, 0, errors.New("admission bind factory returned nil")
+	}
+	receive, actualPort, err := prepared.Open(port)
+	if err != nil {
+		_ = prepared.Close()
+		return nil, 0, err
+	}
+	if len(receive) == 0 {
+		_ = prepared.Close()
+		return nil, 0, errors.New("admission bind opened no receive functions")
+	}
+	if a.mark != 0 {
+		if err := prepared.SetMark(a.mark); err != nil {
+			_ = prepared.Close()
+			return nil, 0, err
+		}
+	}
+	a.next++
+	generation := &admissionBindGeneration{
+		bind:       prepared,
+		receive:    receive,
+		generation: a.next,
+		actualPort: actualPort,
+	}
+	a.pending = generation
+	return generation, actualPort, nil
+}
+
+func (a *admissionBind) PreparedSockets() (admissionPreparedSockets, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.closed || a.pending == nil {
+		return admissionPreparedSockets{}, errAdmissionBindNotPending
+	}
+	peek, ok := a.pending.bind.(conn.PeekLookAtSocketFd)
+	if !ok {
+		return admissionPreparedSockets{}, errors.New("prepared bind does not expose socket descriptors")
+	}
+	result := make([]int, 0, 2)
+	if fd, err := peek.PeekLookAtSocketFd4(); err == nil && fd >= 0 {
+		result = append(result, fd)
+	}
+	if fd, err := peek.PeekLookAtSocketFd6(); err == nil && fd >= 0 {
+		result = append(result, fd)
+	}
+	if len(result) != len(a.pending.receive) {
+		return admissionPreparedSockets{Token: a.pending.generation}, fmt.Errorf(
+			"prepared descriptor count %d does not match receive function count %d",
+			len(result),
+			len(a.pending.receive),
+		)
+	}
+	if len(result) == 2 && result[0] == result[1] {
+		return admissionPreparedSockets{}, errors.New("prepared bind returned duplicate socket descriptors")
+	}
+	return admissionPreparedSockets{Token: a.pending.generation, FDs: result}, nil
+}
+
+func (a *admissionBind) AdmitPreparedToken(token uint64) error {
+	a.mu.Lock()
+	if a.closed {
+		a.mu.Unlock()
+		return errAdmissionBindClosed
+	}
+	if a.pending == nil {
+		a.mu.Unlock()
+		return errAdmissionBindNotPending
+	}
+	if a.pending.generation != token {
+		a.mu.Unlock()
+		return errAdmissionBindGeneration
+	}
+	previous := a.active
+	a.active = a.pending
+	a.pending = nil
+	a.changed.Broadcast()
+	a.mu.Unlock()
+	if previous != nil {
+		_ = previous.bind.Close()
+	}
+	return nil
+}
+
+func (a *admissionBind) AbortPreparedToken(token uint64) error {
+	a.mu.Lock()
+	if a.pending == nil {
+		a.mu.Unlock()
+		return errAdmissionBindNotPending
+	}
+	if a.pending.generation != token {
+		a.mu.Unlock()
+		return errAdmissionBindGeneration
+	}
+	pending := a.pending
+	a.pending = nil
+	a.mu.Unlock()
+	_ = pending.bind.Close()
+	return nil
+}
+
+func (a *admissionBind) ActivePort() (uint16, bool) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.closed || a.active == nil {
+		return 0, false
+	}
+	return a.active.actualPort, true
+}
+
+func (a *admissionBind) receive(
+	index int,
+	packets [][]byte,
+	sizes []int,
+	endpoints []conn.Endpoint,
+) (int, error) {
+	for {
+		a.mu.Lock()
+		for a.active == nil && !a.closed {
+			a.changed.Wait()
+		}
+		if a.closed {
+			a.mu.Unlock()
+			return 0, net.ErrClosed
+		}
+		generation := a.active
+		if index >= len(generation.receive) {
+			a.mu.Unlock()
+			return 0, errors.New("admission bind receive function unavailable")
+		}
+		receive := generation.receive[index]
+		a.mu.Unlock()
+
+		n, err := receive(packets, sizes, endpoints)
+		if !errors.Is(err, net.ErrClosed) {
+			return n, err
+		}
+		a.mu.Lock()
+		closed := a.closed
+		replaced := a.active != generation
+		a.mu.Unlock()
+		if closed {
+			return 0, net.ErrClosed
+		}
+		if replaced {
+			continue
+		}
+		return n, err
+	}
+}
+
+func (a *admissionBind) Close() error {
+	a.mu.Lock()
+	if a.closed {
+		a.mu.Unlock()
+		return nil
+	}
+	a.closed = true
+	active := a.active
+	pending := a.pending
+	a.active = nil
+	a.pending = nil
+	a.changed.Broadcast()
+	a.mu.Unlock()
+
+	var result error
+	if pending != nil {
+		result = pending.bind.Close()
+	}
+	if active != nil {
+		if err := active.bind.Close(); result == nil {
+			result = err
+		}
+	}
+	return result
+}
+
+func (a *admissionBind) SetMark(mark uint32) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.closed {
+		return errAdmissionBindClosed
+	}
+	if a.active != nil {
+		if err := a.active.bind.SetMark(mark); err != nil {
+			return err
+		}
+	}
+	if a.pending != nil {
+		if err := a.pending.bind.SetMark(mark); err != nil {
+			return err
+		}
+	}
+	a.mark = mark
+	return nil
+}
+
+func (a *admissionBind) Send(buffers [][]byte, endpoint conn.Endpoint) error {
+	a.mu.Lock()
+	if a.closed {
+		a.mu.Unlock()
+		return net.ErrClosed
+	}
+	generation := a.active
+	a.mu.Unlock()
+	if generation == nil {
+		// Peers may queue an initial handshake while Kotlin is protecting the
+		// descriptors. Dropping it is safe; admission sends a fresh keepalive.
+		return nil
+	}
+	if endpoint != nil {
+		previous, _ := a.endpointGenerations.Load(endpoint)
+		if previous != generation.generation {
+			endpoint.ClearSrc()
+			a.endpointGenerations.Store(endpoint, generation.generation)
+		}
+	}
+	return generation.bind.Send(buffers, endpoint)
+}
+
+func (a *admissionBind) ParseEndpoint(value string) (conn.Endpoint, error) {
+	return a.parser.ParseEndpoint(value)
+}
+
+func (a *admissionBind) BatchSize() int { return a.parser.BatchSize() }
