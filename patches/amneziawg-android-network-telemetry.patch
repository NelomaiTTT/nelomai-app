index 00000000..9c385825
--- /dev/null
+++ b/tunnel/tools/libwg-go/redundant_tun_fd_test.go
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+package main
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+)
+
+func TestOwnedRedundantTunCreateFailureClosesTransferredFD(t *testing.T) {
+	createFailure := errors.New("create TUN failed")
+	closedFD := -1
+	device, err := createOwnedRedundantTUNFromFD(
+		41,
+		func(fd int) (tun.Device, string, error) {
+			if fd != 41 {
+				t.Fatalf("create fd = %d, want 41", fd)
+			}
+			return nil, "", createFailure
+		},
+		func(fd int) error {
+			closedFD = fd
+			return nil
+		},
+	)
+
+	if device != nil {
+		t.Fatal("failed create returned a device")
+	}
+	if !errors.Is(err, createFailure) {
+		t.Fatalf("create error = %v, want %v", err, createFailure)
+	}
+	if closedFD != 41 {
+		t.Fatalf("closed fd = %d, want 41", closedFD)
+	}
+}
diff --git a/tunnel/tools/libwg-go/redundant_tun_test.go b/tunnel/tools/libwg-go/redundant_tun_test.go
new file mode 100644
index 00000000..c841f5ac
--- /dev/null
+++ b/tunnel/tools/libwg-go/redundant_tun_test.go
@@ -0,0 +1,1507 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+package main
+
+import (
+	"encoding/binary"
+	"errors"
+	"os"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/conn"
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+)
+
+const redundantTUNTestTimeout = 250 * time.Millisecond
+
+func TestNativeHandleAllocatorNeverReusesReleasedIdentifier(t *testing.T) {
+	var allocator monotonicHandleAllocator
+	first := allocator.Next()
+	second := allocator.Next()
+
+	if first <= 0 || second <= 0 || first == second {
+		t.Fatalf("allocator returned first=%d second=%d, want distinct positive identifiers", first, second)
+	}
+}
+
+type fakeRealTUN struct {
+	outbound chan []byte
+	inbound  chan []byte
+	events   chan tun.Event
+	closed   chan struct{}
+	once     sync.Once
+}
+
+type controlledWriteErrorTUN struct {
+	*fakeRealTUN
+	writeStarted chan struct{}
+	releaseWrite chan struct{}
+	startOnce    sync.Once
+}
+
+type blockingConcurrentWriter struct {
+	firstStarted  chan struct{}
+	releaseFirst  chan struct{}
+	secondWritten chan struct{}
+	closed        chan struct{}
+	firstOnce     sync.Once
+	secondOnce    sync.Once
+	closeOnce     sync.Once
+}
+
+func newBlockingConcurrentWriter() *blockingConcurrentWriter {
+	return &blockingConcurrentWriter{
+		firstStarted:  make(chan struct{}),
+		releaseFirst:  make(chan struct{}),
+		secondWritten: make(chan struct{}),
+		closed:        make(chan struct{}),
+	}
+}
+
+func (w *blockingConcurrentWriter) WritePacket(packet []byte) error {
+	if len(packet) > 0 && packet[0] == 1 {
+		w.firstOnce.Do(func() { close(w.firstStarted) })
+		select {
+		case <-w.releaseFirst:
+			return nil
+		case <-w.closed:
+			return os.ErrClosed
+		}
+	}
+	w.secondOnce.Do(func() { close(w.secondWritten) })
+	return nil
+}
+
+func (w *blockingConcurrentWriter) Close() error {
+	w.closeOnce.Do(func() { close(w.closed) })
+	return nil
+}
+
+func newFakeRealTUN() *fakeRealTUN {
+	device := &fakeRealTUN{
+		outbound: make(chan []byte, 8),
+		inbound:  make(chan []byte, 8),
+		events:   make(chan tun.Event, 1),
+		closed:   make(chan struct{}),
+	}
+	device.events <- tun.EventUp
+	return device
+}
+
+func newControlledWriteErrorTUN() *controlledWriteErrorTUN {
+	return &controlledWriteErrorTUN{
+		fakeRealTUN:  newFakeRealTUN(),
+		writeStarted: make(chan struct{}),
+		releaseWrite: make(chan struct{}),
+	}
+}
+
+func (f *controlledWriteErrorTUN) Write(_ [][]byte, _ int) (int, error) {
+	f.startOnce.Do(func() {
+		close(f.writeStarted)
+	})
+	select {
+	case <-f.releaseWrite:
+		return 0, errors.New("controlled real TUN write failure")
+	case <-f.closed:
+		return 0, os.ErrClosed
+	}
+}
+
+func (f *fakeRealTUN) File() *os.File { return nil }
+
+func (f *fakeRealTUN) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	select {
+	case <-f.closed:
+		return 0, os.ErrClosed
+	case packet := <-f.outbound:
+		if len(bufs) == 0 || len(sizes) == 0 || offset < 0 || offset+len(packet) > len(bufs[0]) {
+			return 0, errors.New("fake TUN read buffer is too small")
+		}
+		copy(bufs[0][offset:], packet)
+		sizes[0] = len(packet)
+		return 1, nil
+	}
+}
+
+func (f *fakeRealTUN) Write(bufs [][]byte, offset int) (int, error) {
+	for index, buffer := range bufs {
+		if offset < 0 || offset > len(buffer) {
+			return index, errors.New("invalid fake TUN write offset")
+		}
+		packet := append([]byte(nil), buffer[offset:]...)
+		select {
+		case <-f.closed:
+			return index, os.ErrClosed
+		case f.inbound <- packet:
+		}
+	}
+	return len(bufs), nil
+}
+
+func (f *fakeRealTUN) MTU() (int, error)        { return 1420, nil }
+func (f *fakeRealTUN) Name() (string, error)    { return "fake-real-tun", nil }
+func (f *fakeRealTUN) Events() <-chan tun.Event { return f.events }
+func (f *fakeRealTUN) BatchSize() int           { return 1 }
+
+func (f *fakeRealTUN) Close() error {
+	f.once.Do(func() {
+		close(f.closed)
+		close(f.events)
+	})
+	return nil
+}
+
+func (f *fakeRealTUN) injectOutbound(t *testing.T, packet []byte) {
+	t.Helper()
+	select {
+	case f.outbound <- append([]byte(nil), packet...):
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("timed out injecting outbound packet into fake real TUN")
+	}
+}
+
+func readDevicePacket(t *testing.T, device tun.Device) []byte {
+	t.Helper()
+	result := make(chan struct {
+		packet []byte
+		err    error
+	}, 1)
+	go func() {
+		buffer := make([]byte, 2048)
+		sizes := make([]int, 1)
+		count, err := device.Read([][]byte{buffer}, sizes, 0)
+		if err != nil {
+			result <- struct {
+				packet []byte
+				err    error
+			}{err: err}
+			return
+		}
+		if count != 1 {
+			result <- struct {
+				packet []byte
+				err    error
+			}{err: errors.New("device returned an unexpected packet count")}
+			return
+		}
+		result <- struct {
+			packet []byte
+			err    error
+		}{packet: append([]byte(nil), buffer[:sizes[0]]...)}
+	}()
+	select {
+	case got := <-result:
+		if got.err != nil {
+			t.Fatalf("failed to read device packet: %v", got.err)
+		}
+		return got.packet
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("timed out reading device packet")
+		return nil
+	}
+}
+
+func writeDevicePacket(t *testing.T, device tun.Device, packet []byte) {
+	t.Helper()
+	written, err := device.Write([][]byte{append([]byte(nil), packet...)}, 0)
+	if err != nil {
+		t.Fatalf("failed to write device packet: %v", err)
+	}
+	if written != 1 {
+		t.Fatalf("device wrote %d packets, want 1", written)
+	}
+}
+
+func requireNoDevicePacketBeforeClose(
+	t *testing.T,
+	device tun.Device,
+	closeDevice func() error,
+) {
+	t.Helper()
+	result := make(chan error, 1)
+	go func() {
+		buffer := make([]byte, 2048)
+		_, err := device.Read([][]byte{buffer}, make([]int, 1), 0)
+		result <- err
+	}()
+	select {
+	case err := <-result:
+		t.Fatalf("inactive device returned before close: %v", err)
+	case <-time.After(50 * time.Millisecond):
+	}
+	if err := closeDevice(); err != nil {
+		t.Fatalf("failed to close inactive device: %v", err)
+	}
+	select {
+	case err := <-result:
+		if !errors.Is(err, os.ErrClosed) {
+			t.Fatalf("inactive device returned wrong close error: %v", err)
+		}
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("inactive device read did not unblock after close")
+	}
+}
+
+func requireNoFakeRealTUNPacket(t *testing.T, real *fakeRealTUN) {
+	t.Helper()
+	select {
+	case packet := <-real.inbound:
+		t.Fatalf("unexpected packet reached real TUN: %v", packet)
+	case <-time.After(50 * time.Millisecond):
+	}
+}
+
+func waitForOutboundAccounting(t *testing.T, tunnel *RedundantTunnel, want uint64) {
+	t.Helper()
+	deadline := time.Now().Add(redundantTUNTestTimeout)
+	for time.Now().Before(deadline) {
+		counters := tunnel.Counters()
+		if counters.OutboundPackets+counters.OutboundDropped >= want {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatalf("dispatcher did not account for %d outbound packets", want)
+}
+
+func fakeDNSPacket(sourcePort, destinationPort, dnsID uint16, response bool) []byte {
+	querySource := [4]byte{10, 0, 0, 2}
+	resolver := [4]byte{1, 1, 1, 1}
+	if response {
+		return fakeDNSPacketForQuestion(
+			sourcePort,
+			destinationPort,
+			dnsID,
+			true,
+			resolver,
+			querySource,
+			"health.nelomai.invalid",
+		)
+	}
+	return fakeDNSPacketForQuestion(
+		sourcePort,
+		destinationPort,
+		dnsID,
+		false,
+		querySource,
