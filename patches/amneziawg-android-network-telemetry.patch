+		t.Fatalf("prepare rebound bind: %v", err)
+	}
+	reboundPreparation := requirePreparedSockets(t, bind)
+	if err := bind.AdmitPreparedToken(reboundPreparation.Token); err != nil {
+		t.Fatalf("admit protected rebound bind: %v", err)
+	}
+	if err := bind.Send([][]byte{{1}}, nil); err != nil {
+		t.Fatalf("send through rebound bind: %v", err)
+	}
+	if rebound.sendCalls != 1 {
+		t.Fatalf("rebound bind sent %d packets, want 1", rebound.sendCalls)
+	}
+}
