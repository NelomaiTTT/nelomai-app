+	if err := tunnel.SwitchActive(1); !errors.Is(err, ErrRedundantSlotClosed) {
+		t.Fatalf("switch after direct close returned %v, want %v", err, ErrRedundantSlotClosed)
+	}
+	if got := tunnel.Counters().SlotCloses; got != 1 {
+		t.Fatalf("direct slot close counter is %d, want 1", got)
+	}
