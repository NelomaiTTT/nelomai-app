+func newFakeRedundantTunnel(t *testing.T) (*fakeRealTUN, tun.Device, tun.Device, *RedundantTunnel) {
+	t.Helper()
+	real := newFakeRealTUN()
+	tunnel, err := NewRedundantTunnel(real)
+	if err != nil {
+		t.Fatalf("failed to create redundant tunnel: %v", err)
+	}
+	t.Cleanup(func() {
+		if err := tunnel.Close(); err != nil {
+			t.Errorf("failed to close redundant tunnel: %v", err)
+		}
+	})
+	slotA, err := tunnel.Slot(0)
+	if err != nil {
+		t.Fatalf("failed to get slot A: %v", err)
+	}
+	slotB, err := tunnel.Slot(1)
+	if err != nil {
+		t.Fatalf("failed to get slot B: %v", err)
+	}
+	return real, slotA, slotB, tunnel
+}
