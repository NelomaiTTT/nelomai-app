@@ -173,2 +173,65 @@ public final class GoBackend implements Backend {
 
+    /** Return transport telemetry collected below the WireGuard device counters. */
+    @Nullable
+    public String getNetworkTelemetry(final Tunnel tunnel) {
+        if (tunnel != currentTunnel || currentTunnelHandle == -1)
+            return null;
+        return awgGetNetworkTelemetry(currentTunnelHandle);
+    }
+
+    /** Rotate only the userspace UDP sockets without rebuilding the Android VPN interface. */
+    public void rebindUdp(final Tunnel tunnel) throws Exception {
+        if (tunnel != currentTunnel || currentTunnelHandle == -1)
+            throw new IllegalStateException("Tunnel is not active");
+
+        final VpnService service;
+        try {
+            service = vpnService.get(2, TimeUnit.SECONDS);
+        } catch (final TimeoutException e) {
+            throw new IllegalStateException("VPN service is unavailable", e);
+        }
+        if (awgRebindUdp(currentTunnelHandle) != 0)
+            throw new IllegalStateException("Unable to rebind UDP sockets");
+        final int socketV4 = awgGetSocketV4(currentTunnelHandle);
+        final int socketV6 = awgGetSocketV6(currentTunnelHandle);
+        final boolean socketV4Protected = socketV4 < 0 || service.protect(socketV4);
+        final boolean socketV6Protected = socketV6 < 0 || service.protect(socketV6);
+        if (!socketV4Protected || !socketV6Protected) {
+            awgCloseUdp(currentTunnelHandle);
+            throw new IllegalStateException("Unable to protect rebound UDP sockets");
+        }
+        if (awgSendKeepalives(currentTunnelHandle) != 0)
+            throw new IllegalStateException("Unable to send keepalive after UDP rebind");
+    }
+
+    /** Force a fresh authenticated handshake without expiring the data-plane keypair. */
+    public long startHandshakeProbe(final Tunnel tunnel) {
+        if (tunnel != currentTunnel || currentTunnelHandle == -1)
+            throw new IllegalStateException("Tunnel is not active");
+        final long generation = awgStartHandshakeProbe(currentTunnelHandle);
+        if (generation <= 0)
+            throw new IllegalStateException("Unable to start handshake probe");
+        return generation;
+    }
+
+    /** Report whether the exact native handshake probe generation completed. */
+    public boolean handshakeProbeSucceeded(final Tunnel tunnel, final long generation) {
+        if (tunnel != currentTunnel || currentTunnelHandle == -1)
+            throw new IllegalStateException("Tunnel is not active");
+        final int status = awgHandshakeProbeStatus(currentTunnelHandle, generation);
+        if (status < 0)
+            throw new IllegalStateException("Unable to read handshake probe status");
+        return status == 1;
+    }
+
+    /** Return the native observation window including the configured first retry. */
+    public long handshakeProbeTimeoutMillis(final Tunnel tunnel) {
+        if (tunnel != currentTunnel || currentTunnelHandle == -1)
+            throw new IllegalStateException("Tunnel is not active");
+        final long timeoutMillis = awgHandshakeProbeTimeoutMillis(currentTunnelHandle);
+        if (timeoutMillis <= 0)
+            throw new IllegalStateException("Unable to read handshake probe timeout");
+        return timeoutMillis;
+    }
+
 
