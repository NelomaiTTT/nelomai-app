+func fakeDNSPacket(sourcePort, destinationPort, dnsID uint16, response bool) []byte {
+	querySource := [4]byte{10, 0, 0, 2}
+	resolver := [4]byte{1, 1, 1, 1}
+	if response {
+		return fakeDNSPacketForQuestion(
+			sourcePort,
+			destinationPort,
+			dnsID,
+			true,
+			resolver,
+			querySource,
+			"health.nelomai.invalid",
+		)
+	}
+	return fakeDNSPacketForQuestion(
+		sourcePort,
+		destinationPort,
+		dnsID,
+		false,
+		querySource,
+		resolver,
+		"health.nelomai.invalid",
+	)
+}
+
+func fakeDNSPacketForQuestion(
+	sourcePort, destinationPort, dnsID uint16,
+	response bool,
+	sourceIP, destinationIP [4]byte,
+	labels ...string,
+) []byte {
+	const ipv4HeaderLength = 20
+	const udpHeaderLength = 8
+	dnsQuestion := make([]byte, 0, 64)
+	for _, labelSet := range labels {
+		for len(labelSet) > 0 {
+			labelLength := 0
+			for labelLength < len(labelSet) && labelSet[labelLength] != '.' {
+				labelLength++
+			}
+			dnsQuestion = append(dnsQuestion, byte(labelLength))
+			dnsQuestion = append(dnsQuestion, labelSet[:labelLength]...)
+			if labelLength == len(labelSet) {
+				labelSet = ""
+			} else {
+				labelSet = labelSet[labelLength+1:]
+			}
+		}
+	}
+	dnsQuestion = append(dnsQuestion, 0, 0, 1, 0, 1)
+	dnsLength := 12 + len(dnsQuestion)
+	packet := make([]byte, ipv4HeaderLength+udpHeaderLength+dnsLength)
+	packet[0] = 0x45
+	packet[9] = 17
+	copy(packet[12:16], sourceIP[:])
+	copy(packet[16:20], destinationIP[:])
+	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength:ipv4HeaderLength+2], sourcePort)
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength+2:ipv4HeaderLength+4], destinationPort)
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength+4:ipv4HeaderLength+6], uint16(udpHeaderLength+dnsLength))
+	dnsOffset := ipv4HeaderLength + udpHeaderLength
+	binary.BigEndian.PutUint16(packet[dnsOffset:], dnsID)
+	if response {
+		packet[dnsOffset+2] = 0x80
+	}
+	binary.BigEndian.PutUint16(packet[dnsOffset+4:dnsOffset+6], 1)
+	copy(packet[dnsOffset+12:], dnsQuestion)
+	return packet
+}
+
+func malformedShortDNSPacket(sourcePort, destinationPort, dnsID uint16) []byte {
+	const ipv4HeaderLength = 20
+	const udpHeaderLength = 8
+	packet := make([]byte, ipv4HeaderLength+udpHeaderLength+4)
+	packet[0] = 0x45
+	packet[9] = 17
+	binary.BigEndian.PutUint16(packet[2:4], uint16(len(packet)))
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength:ipv4HeaderLength+2], sourcePort)
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength+2:ipv4HeaderLength+4], destinationPort)
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength+4:ipv4HeaderLength+6], udpHeaderLength+4)
+	binary.BigEndian.PutUint16(packet[ipv4HeaderLength+udpHeaderLength:], dnsID)
+	return packet
+}
