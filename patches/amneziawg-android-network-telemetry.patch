+	int count = awgRedundantPreparedSocketCount(handle, slot, token);
+	if (token <= 0 || count <= 0 || count > 2) {
+		if (token > 0)
+			awgRedundantAbortPreparation(handle, slot, token);
+		return redundant_empty_preparation(env);
+	}
+	jlong values[3];
+	values[0] = (jlong)token;
+	for (int index = 0; index < count; ++index) {
+		int fd = awgRedundantPreparedSocket(handle, slot, token, index);
+		if (fd < 0 || (index > 0 && values[index] == fd)) {
+			awgRedundantAbortPreparation(handle, slot, token);
+			return redundant_empty_preparation(env);
+		}
+		values[index + 1] = (jlong)fd;
+	}
+	jlongArray result = (*env)->NewLongArray(env, count + 1);
+	if (result == NULL) {
+		awgRedundantAbortPreparation(handle, slot, token);
+		return NULL;
+	}
+	(*env)->SetLongArrayRegion(env, result, 0, count + 1, values);
+	if ((*env)->ExceptionCheck(env)) {
+		awgRedundantAbortPreparation(handle, slot, token);
+		return NULL;
+	}
+	return result;
+}
 
