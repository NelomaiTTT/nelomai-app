+
+func TestClosedSlotRejectsEveryInboundWrite(t *testing.T) {
+	_, _, slotB, tunnel := newFakeRedundantTunnel(t)
+	if err := tunnel.CloseSlot(1); err != nil {
+		t.Fatalf("failed to close standby slot: %v", err)
+	}
+
+	for attempt := 0; attempt < redundantTunnelQueueDepth; attempt++ {
+		written, err := slotB.Write([][]byte{{byte(attempt)}}, 0)
+		if !errors.Is(err, os.ErrClosed) || written != 0 {
+			t.Fatalf(
+				"closed slot accepted write %d: packets=%d error=%v",
