+	}
+	return 0
+}
+
+//export awgStartHandshakeProbe
+func awgStartHandshakeProbe(tunnelHandle int32) int64 {
+	handle, ok := lookupTunnelHandle(tunnelHandle)
+	if !ok {
+		return -1
+	}
+	generation := handle.device.StartHandshakeProbe()
+	if generation == 0 || generation > math.MaxInt64 {
+		return -1
+	}
+	return int64(generation)
+}
+
+//export awgHandshakeProbeStatus
+func awgHandshakeProbeStatus(tunnelHandle int32, generation int64) int32 {
+	handle, ok := lookupTunnelHandle(tunnelHandle)
+	if !ok || generation <= 0 {
+		return -1
+	}
+	if handle.device.HandshakeProbeSucceeded(uint64(generation)) {
+		return 1
+	}
+	return 0
+}
+
+//export awgHandshakeProbeTimeoutMillis
+func awgHandshakeProbeTimeoutMillis(tunnelHandle int32) int64 {
+	handle, ok := lookupTunnelHandle(tunnelHandle)
+	if !ok {
+		return -1
+	}
+	return handle.device.HandshakeProbeTimeoutMillis()
+}
+
