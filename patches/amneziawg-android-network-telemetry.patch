+func TestCloseSlotDoesNotDeadlockWithInboundWriteFailure(t *testing.T) {
+	real := newControlledWriteErrorTUN()
+	tunnel, err := NewRedundantTunnel(real)
+	if err != nil {
+		t.Fatalf("failed to create redundant tunnel: %v", err)
+	}
+	slotA, err := tunnel.Slot(0)
+	if err != nil {
+		t.Fatalf("failed to get active slot: %v", err)
+	}
+	writeDevicePacket(t, slotA, []byte{1, 2, 3})
+	select {
+	case <-real.writeStarted:
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("inbound dispatcher did not enter real TUN write")
+	}
+
+	closed := make(chan error, 1)
+	go func() {
+		closed <- tunnel.CloseSlot(0)
+	}()
+	deadline := time.Now().Add(redundantTUNTestTimeout)
+	for tunnel.probeOpMu.TryLock() {
+		tunnel.probeOpMu.Unlock()
+		if time.Now().After(deadline) {
+			t.Fatal("slot close did not acquire the probe-operation fence")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	close(real.releaseWrite)
+	select {
+	case err := <-closed:
+		if err != nil {
+			t.Fatalf("slot close failed after inbound write error: %v", err)
+		}
+	case <-time.After(redundantTUNTestTimeout):
+		t.Fatal("slot close deadlocked with inbound write error")
+	}
+	if !tunnel.Closed() {
+		t.Fatal("inbound write error did not close the redundant tunnel")
+	}
+}
