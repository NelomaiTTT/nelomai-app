+func TestNativeHandleAllocatorNeverReusesReleasedIdentifier(t *testing.T) {
+	var allocator monotonicHandleAllocator
+	first := allocator.Next()
+	second := allocator.Next()
+
+	if first <= 0 || second <= 0 || first == second {
+		t.Fatalf("allocator returned first=%d second=%d, want distinct positive identifiers", first, second)
+	}
+}
