+	TunReadBytes    uint64 `json:"tun_read_bytes"`
+	TunReadErrors   uint64 `json:"tun_read_errors"`
+	TunWritePackets uint64 `json:"tun_write_packets"`
+	TunWriteBytes   uint64 `json:"tun_write_bytes"`
+	TunWriteErrors  uint64 `json:"tun_write_errors"`
+	UdpSendCalls    uint64 `json:"udp_send_calls"`
+	UdpSendPackets  uint64 `json:"udp_send_packets"`
+	UdpSendBytes    uint64 `json:"udp_send_bytes"`
+	UdpSendErrors   uint64 `json:"udp_send_errors"`
+	UdpRecvCalls    uint64 `json:"udp_receive_calls"`
+	UdpRecvPackets  uint64 `json:"udp_receive_packets"`
+	UdpRecvBytes    uint64 `json:"udp_receive_bytes"`
+	UdpRecvErrors   uint64 `json:"udp_receive_errors"`
+	LocalPort       uint16 `json:"local_port"`
+	LastTunReadAt   int64  `json:"last_tun_read_at_unix_ms"`
+	LastTunWriteAt  int64  `json:"last_tun_write_at_unix_ms"`
+	LastUdpSendAt   int64  `json:"last_udp_send_at_unix_ms"`
+	LastUdpRecvAt   int64  `json:"last_udp_receive_at_unix_ms"`
+	LastSendError   string `json:"last_udp_send_error,omitempty"`
+	LastRecvError   string `json:"last_udp_receive_error,omitempty"`
+	LastSendErrno   int    `json:"last_udp_send_errno,omitempty"`
+	LastRecvErrno   int    `json:"last_udp_receive_errno,omitempty"`
+	Endpoint        string `json:"endpoint,omitempty"`
+}
+
+func redactRedundantTelemetry(snapshot tunnelTelemetrySnapshot) tunnelTelemetrySnapshot {
+	snapshot.LastSendError = ""
+	snapshot.LastRecvError = ""
+	snapshot.Endpoint = ""
+	return snapshot
+}
