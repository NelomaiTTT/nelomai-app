+func TestStoppingOneSlotKeepsDispatcherAlive(t *testing.T) {
+	real, slotA, _, tunnel := newFakeRedundantTunnel(t)
+
+	if err := tunnel.CloseSlot(1); err != nil {
+		t.Fatalf("failed to close standby slot: %v", err)
