+func TestSwitchDropsQueuedUserPacketFromFormerActiveSlot(t *testing.T) {
+	real, slotA, slotB, tunnel := newFakeRedundantTunnel(t)
+	stalePacket := []byte{1, 1, 1}
+	real.injectOutbound(t, stalePacket)
+	waitForOutboundAccounting(t, tunnel, 1)
+
+	if err := tunnel.SwitchActive(1); err != nil {
