+	var packets uint64
+	if err == nil {
+		for _, buffer := range bufs {
+			if len(buffer) > offset {
+				bytes += uint64(len(buffer) - offset)
+				packets++
+			}
+		}
+	} else if n > 0 {
+		// Android's native TUN returns the number of bytes written on partial success.
+		bytes = uint64(n)
