+	d.telemetry.tunWriteBytes.Add(bytes)
+	if n > 0 {
+		d.telemetry.lastTunWriteAt.Store(nowUnixMillis())
+	}
+	if err != nil {
+		d.telemetry.tunWriteErrors.Add(1)
