+	jsize length = (*env)->GetArrayLength(env, configuration);
+	if (length <= 0)
+		return redundant_empty_preparation(env);
+	jbyte *bytes = (*env)->GetByteArrayElements(env, configuration, NULL);
+	if (bytes == NULL)
+		return redundant_empty_preparation(env);
+	long long token = awgRedundantPrepareSlot(
+		(long long)handle,
+		slot,
+		(struct go_string){.str = (const char *)bytes, .n = length}
+	);
+	(*env)->ReleaseByteArrayElements(env, configuration, bytes, JNI_ABORT);
+	if (token <= 0)
+		return redundant_empty_preparation(env);
+	return redundant_preparation(env, (long long)handle, slot, token);
+}
