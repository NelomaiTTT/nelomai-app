+func TestRedundantMetricsIncludeBoundedGoRuntimeCounters(t *testing.T) {
+	encoded, err := json.Marshal(redactRedundantTelemetry(tunnelTelemetrySnapshot{
+		GoGoroutines: 8,
+	}))
