+func activeTunnelCount() int {
+	tunnelHandlesMutex.RLock()
+	legacy := len(tunnelHandles)
+	tunnelHandlesMutex.RUnlock()
+	redundantNativeHandlesMutex.RLock()
+	redundant := len(redundantNativeHandles)
+	redundantNativeHandlesMutex.RUnlock()
+	return legacy + redundant
+}
+
+func readGoMemoryStats() runtime.MemStats {
+	now := nowUnixMillis()
+	goMemoryStatsMutex.Lock()
+	defer goMemoryStatsMutex.Unlock()
+	if goMemoryStatsAt == 0 || now-goMemoryStatsAt >= goMemoryStatsIntervalMillis {
+		runtime.ReadMemStats(&goMemoryStats)
+		goMemoryStatsAt = now
+	}
+	return goMemoryStats
+}
+
+func beginGoDeviceStart() {
+	goMemoryLifecycleMutex.Lock()
+	goDevicesStarting.Add(1)
+	goMemoryLifecycleMutex.Unlock()
+}
+
+func finishGoDeviceStart(succeeded bool) {
+	goMemoryLifecycleMutex.Lock()
+	goDevicesStarting.Add(-1)
+	if !succeeded {
+		goDeviceStartFailures.Add(1)
+	}
+	goMemoryLifecycleMutex.Unlock()
+	releaseUnusedGoMemory()
+}
+
+func closeGoDevice(value *device.Device) {
+	value.Close()
+	goDeviceCloses.Add(1)
+}
+
+func releaseUnusedGoMemory() {
+	if goDevicesStarting.Load() != 0 || activeTunnelCount() != 0 ||
+		!goMemoryCleanupRunning.CompareAndSwap(false, true) {
+		return
+	}
+	go func() {
+		defer goMemoryCleanupRunning.Store(false)
+		time.Sleep(goMemoryCleanupDelay)
+		goMemoryLifecycleMutex.Lock()
+		defer goMemoryLifecycleMutex.Unlock()
+		if goDevicesStarting.Load() != 0 || activeTunnelCount() != 0 {
+			return
+		}
+		debug.FreeOSMemory()
+		goMemoryStatsMutex.Lock()
+		goMemoryStatsAt = 0
+		goMemoryStatsMutex.Unlock()
+	}()
+}
