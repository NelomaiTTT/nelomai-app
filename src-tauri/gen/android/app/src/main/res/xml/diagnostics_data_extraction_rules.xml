<?xml version="1.0" encoding="utf-8"?>
<!-- Match diagnostics_backup_rules.xml for Android 12+ backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="diagnostics/automatic" />
        <exclude domain="file" path="runtime/latest/state" />
        <exclude domain="file" path="runtime/stable/state" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="diagnostics/automatic" />
        <exclude domain="file" path="runtime/latest/state" />
        <exclude domain="file" path="runtime/stable/state" />
    </device-transfer>
</data-extraction-rules>
